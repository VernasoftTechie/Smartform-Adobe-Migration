"_ROW16 / WORDS
gs_labels-lb__row16_words = COND string(
                              WHEN gv_inco1 <> ' ' OR gv_inco2 <> ' '
                              THEN COND string( WHEN lv_fr = abap_true
                                     THEN |Montant Total en Lettre(|
                                          && |{ lv_ktext }|
                                          && |): |
                                          && |{ lv_amt_words }|
                                          && | |
                                          && |{ gv_inco1 }|
                                          && | |
                                          && |{ gv_inco2 }|
                                     ELSE |Total Order Value In Words(|
                                          && |{ lv_ktext }|
                                          && |): |
                                          && |{ lv_amt_words }|
                                          && | |
                                          && |{ gv_inco1 }|
                                          && | |
                                          && |{ gv_inco2 }|
                                          && | basis| )
                              WHEN gv_inco1 = ' ' AND gv_inco2 = ' '
                              THEN COND string( WHEN lv_fr = abap_true
                                     THEN |Montant Total en Lettre(|
                                          && |{ v_waers }|
                                          && |): |
                                          && |{ lv_amt_words }|
                                          && | |
                                          && |{ gv_inco1 }|
                                          && | |
                                          && |{ gv_inco2 }|
                                     ELSE |Total order Value In Words(|
                                          && |{ lv_ktext }|
                                          && |): |
                                          && |{ lv_amt_words }| )
                              ELSE || ).
