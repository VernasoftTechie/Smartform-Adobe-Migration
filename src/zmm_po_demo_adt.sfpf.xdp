<?xml version="1.0" encoding="utf-8"?>
<?xfa generator="AdobeLiveCycleDesigner_V11.0.9.20240701.1.52_SAP" APIVersion="3.6.24183.0"?><xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/" timeStamp="2026-10-06T06:29:50Z" uuid="7c374557-7141-4112-9aa6-27bf14213067">
<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
   <?formServer defaultPDFRenderFormat acrobat10.0dynamic?>
   <subform layout="tb" locale="en_IN" name="data" restoreState="auto">
      <pageSet>
         <pageArea id="Page1" name="Page1">
            <contentArea h="21.83cm" w="16.43cm" x="2.2cm" y="3.53cm"/>
            <medium long="29.7cm" short="21cm" stock="a4"/>
            <!-- Master page: prints on every page. Title - evidence: %WINDOW2 (15.57 x 2.00 cm at 2.47 / 0.53),
                 one text, SmartStyle ZMM_STYLE paragraph P1. ZMM_STYLE fonts are not in the export, so
                 Arial 14pt bold centered is a placeholder until its definition is supplied. -->
            <draw h="2cm" name="lbl_title" w="15.57cm" x="2.47cm" y="0.53cm">
               <value><text>Purchase Order Form</text></value>
               <font size="14pt" typeface="Arial" weight="bold"/>
               <para hAlign="center"/>
            </draw>
            <!-- Main window outline - evidence: MAIN window 16.43 x 17.39 cm at 2.20 / 7.97, border on all four sides.
                 Fixed on the page like the legacy window; the item rows flow inside it. -->
            <draw h="17.39cm" name="main_box" w="16.43cm" x="2.2cm" y="7.97cm">
               <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
            </draw>
            <?templateDesigner expand 1?></pageArea>
         <?templateDesigner expand 1?></pageSet>
      <subform layout="tb" name="po_doc" w="16.43cm">
         <bind match="none"/>
         <!-- page_head: PO header grid + column headings. First child, so it prints at the top of page 1;
              named as the overflow leader of table_row, so it prints again at the top of every continuation
              page (same arrangement as detailHeader in Adobe's own Dunning Notice / Purchase Order samples).
              Evidence for the grid: %TEMPLATE1, 4 rows of label (col 1) | value (col 2), 8cm cells,
              row/col read from T_LINENR/T_CELLNR. Column headings: %CELL1-5, widths 3/3/4/2/4 cm. -->
         <subform h="5.84cm" id="page_head" layout="position" name="page_head" w="16.43cm">
            <occur max="-1"/>
            <bind match="none"/>
            <font size="9pt" typeface="Arial"/>
            <subform h="0.6cm" layout="position" name="hdr_ebeln" w="16cm" x="0.23cm" y="0cm">
               <bind match="none"/>
               <draw h="0.6cm" name="lbl_ebeln" w="8cm" x="0cm" y="0cm"><value><text>PO Number</text></value></draw>
               <field h="0.6cm" name="fld_ebeln" w="8cm" x="8cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.EBELN"/></field>
            </subform>
            <subform h="0.6cm" layout="position" name="hdr_bukrs" w="16cm" x="0.23cm" y="0.6cm">
               <bind match="none"/>
               <draw h="0.6cm" name="lbl_bukrs" w="8cm" x="0cm" y="0cm"><value><text>Company Code</text></value></draw>
               <field h="0.6cm" name="fld_bukrs" w="8cm" x="8cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.BUKRS"/></field>
            </subform>
            <subform h="0.6cm" layout="position" name="hdr_waers" w="16cm" x="0.23cm" y="1.2cm">
               <bind match="none"/>
               <draw h="0.6cm" name="lbl_waers" w="8cm" x="0cm" y="0cm"><value><text>Currency Key</text></value></draw>
               <field h="0.6cm" name="fld_waers" w="8cm" x="8cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.WAERS"/></field>
            </subform>
            <subform h="0.6cm" layout="position" name="hdr_zterm" w="16cm" x="0.23cm" y="1.8cm">
               <bind match="none"/>
               <draw h="0.6cm" name="lbl_zterm" w="8cm" x="0cm" y="0cm"><value><text>Terms of Payment Key</text></value></draw>
               <field h="0.6cm" name="fld_zterm" w="8cm" x="8cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.ZTERM"/></field>
            </subform>
            <subform h="1.4cm" layout="position" name="table_header" w="16cm" x="0cm" y="4.44cm">
               <bind match="none"/>
               <font size="8pt" typeface="Arial" weight="bold"/>
               <draw h="1.4cm" name="h01" w="3cm" x="0cm" y="0cm"><value><text>Purchasing Document Number</text></value></draw>
               <draw h="1.4cm" name="h02" w="3cm" x="3cm" y="0cm"><value><text>Po Item Number</text></value></draw>
               <draw h="1.4cm" name="h03" w="4cm" x="6cm" y="0cm"><value><text>Material Number</text></value></draw>
               <draw h="1.4cm" name="h04" w="2cm" x="10cm" y="0cm"><value><text>Plant</text></value></draw>
               <draw h="1.4cm" name="h05" w="4cm" x="12cm" y="0cm"><value><text>Storage Location</text></value></draw>
            </subform>
         </subform>
         <!-- Items - evidence: %TABLE1 on LT_EKPO. Row bind $.LT_EKPO.DATA[*] with bare field refs (S07 pattern 5). -->
         <subform h="0.55cm" layout="position" name="table_row" w="16cm">
            <occur max="-1" min="0"/>
            <bind match="dataRef" ref="$.LT_EKPO.DATA[*]"/>
            <font size="8pt" typeface="Arial"/>
               <field h="0.55cm" name="c01" w="3cm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="EBELN"/></field>
               <field h="0.55cm" name="c02" w="3cm" x="3cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="EBELP"/></field>
               <field h="0.55cm" name="c03" w="4cm" x="6cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="MATNR"/></field>
               <field h="0.55cm" name="c04" w="2cm" x="10cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="WERKS"/></field>
               <field h="0.55cm" name="c05" w="4cm" x="12cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="LGORT"/></field>
            <overflow leader="page_head"/>
         </subform>
      </subform>
      <proto/>
      <desc>
         <text name="version">11.0.9.20240701.1.52.2</text>
      </desc>
      <?templateDesigner expand 1?></subform>
   <?templateDesigner DefaultPreviewDynamic 1?>
   <?templateDesigner DefaultRunAt client?>
   <?templateDesigner Grid show:1, snap:1, units:0, color:ff8080, origin:(0,0), interval:(125000,125000)?>
   <?templateDesigner FormTargetVersion 33?>
   <?templateDesigner WidowOrphanControl 0?>
   <?templateDesigner DefaultCaptionFontSettings face:Arial;size:10;weight:normal;style:normal?>
   <?templateDesigner DefaultValueFontSettings face:Arial;size:10;weight:normal;style:normal?>
   <?templateDesigner DefaultLanguage JavaScript?>
   <?acrobat JavaScript strictScoping?>
   <?templateDesigner Rulers horizontal:1, vertical:1, guidelines:1, crosshairs:0?>
   <?templateDesigner Zoom 111?></template>
