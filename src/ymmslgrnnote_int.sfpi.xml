     <INITIALIZATION>
      <FPCLINE>* BOLT: break abap1.  (debug breakpoint of the legacy form for user ABAP1 - not carried, no effect on the output)</FPCLINE>
      <FPCLINE/>
      <FPCLINE>select single  butxt from t001 into lv_butxt where bukrs = ls_mseg-bukrs.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*break developer.</FPCLINE>
      <FPCLINE>CALL FUNCTION &apos;ISP_GET_MONTH_NAME&apos;"#EC CI_USAGE_OK[2469385]</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>   DATE               = ls_mkpf-bldat</FPCLINE>
      <FPCLINE>    LANGUAGE           = SY-LANGU</FPCLINE>
      <FPCLINE>*   MONTH_NUMBER       = MON_NO</FPCLINE>
      <FPCLINE> IMPORTING</FPCLINE>
      <FPCLINE>*   LANGU_BACK         =</FPCLINE>
      <FPCLINE>*   LONGTEXT           = MONTH</FPCLINE>
      <FPCLINE>   SHORTTEXT          = MONTH</FPCLINE>
      <FPCLINE> EXCEPTIONS</FPCLINE>
      <FPCLINE>   CALENDAR_ID        = 1</FPCLINE>
      <FPCLINE>   DATE_ERROR         = 2</FPCLINE>
      <FPCLINE>   NOT_FOUND          = 3</FPCLINE>
      <FPCLINE>   WRONG_INPUT        = 4</FPCLINE>
      <FPCLINE>   OTHERS             = 5</FPCLINE>
      <FPCLINE>          .</FPCLINE>
      <FPCLINE>IF SY-SUBRC &lt;&gt; 0.</FPCLINE>
      <FPCLINE>* Implement suitable error handling here</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CONCATENATE ls_mkpf-bldat+6(2)&apos;-&apos; month&apos;-&apos;ls_mkpf-bldat+0(4)</FPCLINE>
      <FPCLINE>   into date.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-8): main window, table %TABLE1 over LT_MSEG ===============================</FPCLINE>
      <FPCLINE>" %CODE1 (unit rate) and %CODE3 (amount, VAT, freight sum) ran once per item in the Smart Form.</FPCLINE>
      <FPCLINE>" An Adobe table cannot run code, so they run here, verbatim, in a LOOP; GT_ITEM_ROWS keeps what</FPCLINE>
      <FPCLINE>" the row printed (XOF / XAF: the whole-number amounts of %TEXT32 / %TEXT33).</FPCLINE>
      <FPCLINE>DATA lv_bolt_out TYPE c LENGTH 255.</FPCLINE>
      <FPCLINE>DATA lv_bolt_a   TYPE string.</FPCLINE>
      <FPCLINE>DATA lv_bolt_b   TYPE string.</FPCLINE>
      <FPCLINE>LOOP AT lt_mseg INTO wa_mseg.</FPCLINE>
      <FPCLINE>* --- %CODE1 New Program Lines 1 (verbatim)</FPCLINE>
      <FPCLINE>**break abap8.</FPCLINE>
      <FPCLINE>*lv_unit = wa_mseg-dmbtr .</FPCLINE>
      <FPCLINE>  IF WA_MSEG-WAERS = &apos;XOF&apos; OR WA_MSEG-WAERS = &apos;XAF&apos;.</FPCLINE>
      <FPCLINE>    CLEAR LV_AMOUNT.</FPCLINE>
      <FPCLINE>    LV_AMOUNT = WA_MSEG-LV_URATE.</FPCLINE>
      <FPCLINE>    CALL FUNCTION                   "#EC CI_USAGE_OK[2340247]</FPCLINE>
      <FPCLINE>      &apos;CURRENCY_AMOUNT_SAP_TO_DISPLAY&apos;</FPCLINE>
      <FPCLINE>      EXPORTING</FPCLINE>
      <FPCLINE>        CURRENCY        = WA_MSEG-WAERS</FPCLINE>
      <FPCLINE>        AMOUNT_INTERNAL = LV_AMOUNT</FPCLINE>
      <FPCLINE>      IMPORTING</FPCLINE>
      <FPCLINE>        AMOUNT_DISPLAY  = LV_AMOUNT</FPCLINE>
      <FPCLINE>      EXCEPTIONS</FPCLINE>
      <FPCLINE>        INTERNAL_ERROR  = 1</FPCLINE>
      <FPCLINE>        OTHERS          = 2.</FPCLINE>
      <FPCLINE>    IF SY-SUBRC &lt;&gt; 0.</FPCLINE>
      <FPCLINE>* Implement suitable error handling here</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*lv_unit_xof = wa_mseg-lv_urate.</FPCLINE>
      <FPCLINE>    LV_UNIT_XOF = LV_AMOUNT.</FPCLINE>
      <FPCLINE>    CLEAR LV_AMOUNT.</FPCLINE>
      <FPCLINE>  ELSE.</FPCLINE>
      <FPCLINE>    LV_UNIT = WA_MSEG-LV_URATE.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>* --- %CODE3 New Program Lines 3 (verbatim)</FPCLINE>
      <FPCLINE>  VAT = WA_MSEG-VAT.</FPCLINE>
      <FPCLINE>  SUM = SUM + WA_MSEG-BNBTR.</FPCLINE>
      <FPCLINE>*FRI = wa_mseg-FRI.</FPCLINE>
      <FPCLINE>*OTH = wa_mseg-OTH.</FPCLINE>
      <FPCLINE>*DIS = wa_mseg-DIS.</FPCLINE>
      <FPCLINE>*FINAL_AMT = ( WA_MSEG-DMBTR * WA_MSEG-ERFMG ).</FPCLINE>
      <FPCLINE>  FINAL_AMT =                "#EC CI_FLDEXT_OK[2610650]</FPCLINE>
      <FPCLINE>  ( WA_MSEG-LV_URATE * WA_MSEG-ERFMG ).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  IF WA_MSEG-WAERS = &apos;XOF&apos; OR WA_MSEG-WAERS = &apos;XAF&apos;.</FPCLINE>
      <FPCLINE>    CLEAR LV_AMOUNT.</FPCLINE>
      <FPCLINE>    LV_AMOUNT = VAT.</FPCLINE>
      <FPCLINE>    CALL FUNCTION                               "#EC CI_USAGE_OK[2340247]</FPCLINE>
      <FPCLINE>      &apos;CURRENCY_AMOUNT_SAP_TO_DISPLAY&apos;</FPCLINE>
      <FPCLINE>      EXPORTING</FPCLINE>
      <FPCLINE>        CURRENCY        = WA_MSEG-WAERS</FPCLINE>
      <FPCLINE>        AMOUNT_INTERNAL = LV_AMOUNT</FPCLINE>
      <FPCLINE>      IMPORTING</FPCLINE>
      <FPCLINE>        AMOUNT_DISPLAY  = LV_AMOUNT</FPCLINE>
      <FPCLINE>      EXCEPTIONS</FPCLINE>
      <FPCLINE>        INTERNAL_ERROR  = 1</FPCLINE>
      <FPCLINE>        OTHERS          = 2.</FPCLINE>
      <FPCLINE>    IF SY-SUBRC &lt;&gt; 0.</FPCLINE>
      <FPCLINE>* Implement suitable error handling here</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE>    LV_VAT_XOF = LV_AMOUNT.</FPCLINE>
      <FPCLINE/>
