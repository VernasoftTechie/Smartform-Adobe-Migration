         <field h="9.3mm" name="date_display" w="76mm" x="5mm" y="198.7mm">
            <event activity="initialize" name="initialize">
               <script contentType="application/x-javascript">var sourceDate = this.parent.resolveNode("badat");
var value = sourceDate ? String(sourceDate.rawValue || "") : "";
var match = /^(\d{4})(\d{2})(\d{2})$/.exec(value) || /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
if (!match) {
  this.rawValue = value;
} else {
  var date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
  var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  this.rawValue = days[date.getDay()] + ", " + date.getDate() + " " + months[date.getMonth()] + " " + date.getFullYear();
}</script>
            </event>
            <ui><textEdit/></ui>
            <font size="10pt" typeface="Times New Roman" weight="bold" posture="italic"/>
         </field>
         <field h="11mm" name="page_footer" w="40.3mm" x="240mm" y="198.3mm">
