<?xml version="1.0" encoding="UTF-8"?>
<!--
  Z_MM_PR_FORM_ADT.SFPF - layout (XDP)

  Hand-authored Adobe LiveCycle Designer template (XFA), built directly
  from the real Smart Form export - not the SFP "Create by Migration"
  wizard. Every position/size/font/field matches
  docs/legacy_grab/Z_MM_PR_FORM_build_checklist.md exactly.

  FORMAT FIX (2026-09-12): this used to be a standalone top-level .XDP
  file plus a separate SFPF_*.XML with the layout base64-embedded inside
  it. abapGit could not read either shape. The real abapGit serializer
  for object type SFPF (LCL_OBJECT_SFPF) splits the object into TWO
  companion files - this one (the plain, unencoded XDP) and
  z_mm_pr_form_adt.sfpf.xml (the metadata, wrapped in an <abapGit>
  root, with LAYOUT left as a stub pointing here). Confirmed against a
  real abapGit-serialized object pulled into this repo by the user:
  src/zhello_world_form_adt.sfpf.xdp / .sfpf.xml.

  STRUCTURE FIX (v3.0, 2026-09-12): the user provided a third, complete
  and fully-readable real reference (ZSD_SODETAILS_FORMS - a Sales Order
  Details form), the first one small enough to read end-to-end rather
  than in fragments. It exposed three structural defects versus what was
  built here, all now fixed:
    1. The root template subform must be named "data" (matching XFA's
       own root-data-wrapper convention), never the form's own object
       name. Both Hello World AND this new reference agree - was
       "Z_MM_PR_FORM_ADT", wrong.
    2. Every <bind> needs match="dataRef" alongside ref="$.FIELDNAME" -
       the "$." prefix was correct all along (v2.7 wrongly replaced it
       with "$record." based on a single, probably graphic-specific,
       data point from the Z_ADT reference); the actually-missing piece
       was the match attribute, present on every bind in this new
       reference and absent from every one of ours.
    3. Absolutely-positioned content subforms belong nested DIRECTLY
       INSIDE <pageArea>, not as top-level siblings of <pageSet> under a
       layout="position" root. The real reference's root is layout="tb"
       (like Hello World), and every one of its x/y-positioned content
       subforms sits inside <pageArea> - that's what gives them a fixed
       coordinate space to be measured against. Restructured to match.

  BEFORE importing this layout, add these two fields to the SFP Form
  Interface tab (this file does not create them - it only references
  them): IV_REQ_EMAIL TYPE STRING OPTIONAL, IV_FRGKZ TYPE EBAN-FRGKZ
  OPTIONAL. See build checklist section 6.1/6.2 for why. These are
  additive/optional - the confirmed original 16 IMPORT_PARAMETERS are
  otherwise unchanged (see z_mm_pr_form_adt.sfpi.xml).

  Table scope note: a genuinely-migrated sibling reference for this same
  form (Z_ADT_MM_PR_FORM, staged by the user from Sn/) shows the real
  line-item structure (T_FINAL TYPE ZTABLE_PR_PRINT) carries 31 fields
  plus 3 nested long-text loops per row - this layout intentionally
  binds only the 14 columns already confirmed in the build checklist.
  Widening to the full structure is a scope decision for the user, not
  assumed here. See docs/reference_examples_z_adt_mm_pr_form/README.md.
-->
<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">

  <config xmlns="http://www.xfa.org/schema/xci/3.0/">
    <present>
      <pdf>
        <version>1.7</version>
        <adobeExtensionLevel>8</adobeExtensionLevel>
      </pdf>
      <common>
        <template>
          <base/>
        </template>
        <locale>en_US</locale>
      </common>
      <xdp>
        <packets>*</packets>
      </xdp>
    </present>
  </config>

  <template xmlns:xliff="urn:oasis:names:tc:xliff:document:1.1" xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
    <subform layout="tb" locale="en_US" name="data" restoreState="auto">

      <pageSet>
        <pageArea name="Page1" id="Page1">
          <occur min="0" max="-1"/>
          <contentArea x="0cm" y="0cm" w="29.7cm" h="21cm"/>
          <medium stock="a4" orientation="landscape"/>

          <!-- ===================== LOGO ===================== -->
          <subform name="logo" x="0.60cm" y="0.20cm" w="5.42cm" h="2.82cm" layout="position">
            <bind match="none"/>
            <field name="logo_image" w="5.42cm" h="2.82cm">
              <ui><imageEdit/></ui>
              <bind match="none"/>
              <value>
                <!-- Real reference (Z_ADT_MM_PR_FORM.XDP) binds this via a live
                     URL into the SAP graphics repository rather than an
                     embedded bitmap:
                     href="/sap/bc/fp/graphics/public/graphics/bmap/bcol/dangote logo.bmp"
                     (SE78 object GRAPHICS, id BMAP, type BCOL, name
                     "dangote logo"). That matches the Global Style/Logo
                     Catalogue approach (one MIME object, reused by all
                     500+ forms) better than embedding a copy per form -
                     adopted here in place of the earlier empty-embed
                     placeholder. Confirm the exact SE78 path once in the
                     target system. -->
                <image contentType="image/bmp" href="/sap/bc/fp/graphics/public/graphics/bmap/bcol/dangote logo.bmp"/>
              </value>
            </field>
          </subform>

          <!-- ===================== HEADER (company + title) ===================== -->
          <subform name="header" x="6.60cm" y="0.40cm" w="17.47cm" h="2.20cm" layout="tb">
            <bind match="none"/>
            <draw name="company_line" w="17.47cm" h="0.70cm">
              <font typeface="Times New Roman" size="15pt" weight="bold"/>
              <para hAlign="center"/>
              <value><text>Dangote Group</text></value>
              <bind match="none"/>
              <!-- static placeholder - SFP will show &lv_company& as available
                   data if you prefer a bound field instead of static text -->
            </draw>
            <field name="plant_name" w="17.47cm" h="0.70cm">
              <ui><textEdit/></ui>
              <font typeface="Times New Roman" size="15pt" weight="bold"/>
              <para hAlign="center"/>
              <bind match="dataRef" ref="$.PLANT_NAME"/>
            </field>
            <draw name="form_title" w="17.47cm" h="0.70cm">
              <font typeface="Times New Roman" size="15pt" weight="bold"/>
              <para hAlign="center"/>
              <value><text>PURCHASE REQUISITION FORM</text></value>
            </draw>
          </subform>

          <!-- ===================== TYPE OF REQUEST ===================== -->
          <subform name="type_of_request" x="0.53cm" y="4.00cm" w="15.73cm" h="1.20cm" layout="tb">
            <bind match="none"/>
            <draw name="type_line1" w="15.73cm" h="0.60cm">
              <font typeface="Times New Roman" size="10pt"/>
              <para hAlign="left"/>
              <value><text>
                <exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml">
                  <p><b>Type of Request&#160;&#160;&#160;&#160;:&#160;&#160;</b>Revenue/Capital Spares/General Consumables</p>
                </body></exData>
              </text></value>
            </draw>
            <draw name="type_line2" w="15.73cm" h="0.60cm">
              <font typeface="Times New Roman" size="10pt"/>
              <para hAlign="left"/>
              <value><text>
                <exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml">
                  <p><b>Equipment Details:</b></p>
                </body></exData>
              </text></value>
            </draw>
          </subform>

          <!-- ===================== PR HEADER (identity block) ===================== -->
          <subform name="pr_header" x="19.33cm" y="4.00cm" w="9.60cm" h="2.47cm" layout="tb">
            <bind match="none"/>
            <subform name="pr_line_lprno" w="9.60cm" h="0.49cm" layout="row">
              <bind match="none"/>
              <draw name="lbl_lprno" w="2.60cm" h="0.49cm">
                <font typeface="Times New Roman" size="10pt" weight="bold"/>
                <value><text>LPR No :</text></value>
              </draw>
              <field name="fld_banfn" w="7.00cm" h="0.49cm">
                <ui><textEdit/></ui>
                <font typeface="Courier New" size="11pt"/>
                <bind match="dataRef" ref="$.BANFN"/>
              </field>
            </subform>
            <subform name="pr_line_lprdate" w="9.60cm" h="0.49cm" layout="row">
              <bind match="none"/>
              <draw name="lbl_lprdate" w="2.60cm" h="0.49cm">
                <font typeface="Times New Roman" size="10pt" weight="bold"/>
                <value><text>LPR Date :</text></value>
              </draw>
              <field name="fld_badat" w="7.00cm" h="0.49cm">
                <ui><textEdit/></ui>
                <font typeface="Courier New" size="11pt"/>
                <bind match="dataRef" ref="$.BADAT"/>
              </field>
            </subform>
            <subform name="pr_line_dept" w="9.60cm" h="0.49cm" layout="row">
              <bind match="none"/>
              <draw name="lbl_dept" w="2.60cm" h="0.49cm">
                <font typeface="Times New Roman" size="10pt" weight="bold"/>
                <value><text>Department:</text></value>
              </draw>
              <field name="fld_eknam" w="7.00cm" h="0.49cm">
                <ui><textEdit/></ui>
                <font typeface="Courier New" size="11pt"/>
                <bind match="dataRef" ref="$.EKNAM"/>
              </field>
            </subform>
            <subform name="pr_line_section" w="9.60cm" h="0.49cm" layout="row">
              <bind match="none"/>
              <draw name="lbl_section" w="2.60cm" h="0.49cm">
                <font typeface="Times New Roman" size="10pt" weight="bold"/>
                <value><text>Section :</text></value>
              </draw>
              <field name="fld_bednr" w="7.00cm" h="0.49cm">
                <ui><textEdit/></ui>
                <font typeface="Courier New" size="11pt"/>
                <bind match="dataRef" ref="$.BEDNR"/>
              </field>
            </subform>
            <subform name="pr_line_email" w="9.60cm" h="0.51cm" layout="row">
              <bind match="none"/>
              <draw name="lbl_email" w="2.60cm" h="0.51cm">
                <font typeface="Times New Roman" size="10pt" weight="bold"/>
                <value><text>Email :</text></value>
              </draw>
              <field name="fld_email" w="7.00cm" h="0.51cm">
                <ui><textEdit/></ui>
                <font typeface="Courier New" size="11pt"/>
                <!-- new optional interface parameter - build checklist 6.1 -->
                <bind match="dataRef" ref="$.IV_REQ_EMAIL"/>
              </field>
            </subform>
          </subform>

          <!-- ===================== VALUE LINE ===================== -->
          <subform name="value_line" x="0.50cm" y="5.47cm" w="13.97cm" h="0.50cm" layout="row">
            <bind match="none"/>
            <draw name="lbl_value" w="7.50cm" h="0.50cm">
              <font typeface="Times New Roman" size="10pt" weight="bold"/>
              <value><text>Estimated Value of this LPR :</text></value>
            </draw>
            <field name="fld_exttotal" w="4.50cm" h="0.50cm">
              <ui><numericEdit/></ui>
              <font typeface="Times New Roman" size="10pt"/>
              <bind match="dataRef" ref="$.V_EXTTOTAL"/>
            </field>
            <field name="fld_waers" w="1.97cm" h="0.50cm">
              <ui><textEdit/></ui>
              <font typeface="Times New Roman" size="10pt"/>
              <bind match="dataRef" ref="$.V_WAERS"/>
            </field>
          </subform>

          <!-- ===================== WATERMARK (conditional) ===================== -->
          <subform name="watermark" x="2.20cm" y="10.40cm" w="20.50cm" h="8.80cm" layout="position" presence="hidden">
            <bind match="none"/>
            <draw name="watermark_text" w="20.50cm" h="8.80cm">
              <font typeface="Times New Roman" size="72pt" weight="bold"/>
              <para hAlign="center" vAlign="middle"/>
              <value><text>PENDING RELEASE</text></value>
              <!-- exact wording not captured in the export - confirm the real
                   watermark text in SE71 before finalizing; position/condition
                   are correct regardless -->
            </draw>
            <event name="watermarkVisibility" activity="initialize">
              <script contentType="application/x-javascript"><![CDATA[
                // build checklist section 6.2 - new optional interface
                // parameter IV_FRGKZ. Unmodified caller -> blank -> hidden.
                //
                // Note: the real reference interface (Z_INT_MM_PR_FORM) does
                // NOT carry an FRGKZ-equivalent import parameter, and its
                // CL_FP_CODING/INITIALIZATION is only 2 lines (V_DATE,
                // LV_WERKS) - it does not derive this flag either. Either
                // that reference doesn't implement the watermark, or it is
                // resolved further upstream than this interface exposes.
                // Unresolved - see docs/reference_examples_z_adt_mm_pr_form/README.md.
                if (fld_frgkz.rawValue == "R" || fld_frgkz.rawValue == "2") {
                    this.presence = "visible";
                } else {
                    this.presence = "hidden";
                }
              ]]></script>
            </event>
            <field name="fld_frgkz" w="0cm" h="0cm" presence="invisible">
              <ui><textEdit/></ui>
              <bind match="dataRef" ref="$.IV_FRGKZ"/>
            </field>
          </subform>

          <!-- ===================== DATE LINE (computed) ===================== -->
          <subform name="date_line" x="0.50cm" y="19.87cm" w="7.60cm" h="0.93cm" layout="position">
            <bind match="none"/>
            <draw name="date_text" w="7.60cm" h="0.93cm">
              <font typeface="Times New Roman" size="10pt"/>
              <para hAlign="left"/>
              <value><text></text></value>
            </draw>
            <event name="dateSpellOut" activity="initialize">
              <script contentType="application/x-javascript"><![CDATA[
                // build checklist section 6.3 - no interface change needed,
                // BADAT already available. Replaces ZABF_DATE_TO_DAY /
                // ZABF_ISP_GET_MONTH_NAME. Adjust the date parse to whatever
                // format SFP actually binds BADAT as once you're in the tool.
                var wkE = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
                var wkF = ["Dimanche","Lundi","Mardi","Mercredi","Jeudi","Vendredi","Samedi"];
                var moE = ["January","February","March","April","May","June","July",
                           "August","September","October","November","December"];
                var moF = ["Janvier","Fevrier","Mars","Avril","Mai","Juin","Juillet",
                           "Aout","Septembre","Octobre","Novembre","Decembre"];

                var dObj = new Date(fld_badat.rawValue);
                var dow = dObj.getDay();
                var mm = dObj.getMonth();
                var lang = (xfa.form.language == "fr") ? "F" : "E";
                var weekday = (lang == "F") ? wkF[dow] : wkE[dow];
                var month   = (lang == "F") ? moF[mm]  : moE[mm];

                date_text.rawValue = weekday + ", " + month + " " + fld_badat.rawValue;
              ]]></script>
            </event>
          </subform>

          <!-- ===================== PAGE FOOTER ===================== -->
          <subform name="page_footer" x="24.00cm" y="19.83cm" w="4.03cm" h="1.10cm" layout="row">
            <bind match="none"/>
            <font typeface="Times New Roman" size="15pt" weight="bold" posture="italic"/>
            <draw name="page_lbl" w="1.20cm" h="1.10cm">
              <value><text>Page</text></value>
            </draw>
            <field name="page_current" w="0.70cm" h="1.10cm">
              <ui><numericEdit/></ui>
              <bind match="none"/>
              <value><float/></value>
              <calculate><script contentType="application/x-formcalc">$ = xfa.layout.page(this)</script></calculate>
            </field>
            <draw name="page_of" w="0.50cm" h="1.10cm">
              <value><text>of</text></value>
            </draw>
            <field name="page_total" w="0.70cm" h="1.10cm">
              <ui><numericEdit/></ui>
              <bind match="none"/>
              <value><float/></value>
              <calculate><script contentType="application/x-formcalc">$ = xfa.layout.pageCount()</script></calculate>
            </field>
          </subform>

          <!-- ===================== MAIN: LINE-ITEMS TABLE ===================== -->
          <subform name="main" x="0.50cm" y="6.50cm" w="28.03cm" h="13.20cm" layout="tb">
            <bind match="none"/>

            <subform name="table_header" w="28.03cm" h="0.60cm" layout="row">
              <bind match="none"/>
              <font typeface="Times New Roman" size="10pt" weight="bold"/>
              <draw name="h01" w="0.80cm" h="0.60cm"><value><text>S.No</text></value></draw>
              <draw name="h02" w="2.50cm" h="0.60cm"><value><text>Item Code</text></value></draw>
              <draw name="h03" w="5.66cm" h="0.60cm"><value><text>Description and Part Number</text></value></draw>
              <draw name="h04" w="1.14cm" h="0.60cm"><value><text>Unit</text></value></draw>
              <draw name="h05" w="2.22cm" h="0.60cm"><value><text>Req Qty</text></value></draw>
              <draw name="h06" w="2.40cm" h="0.60cm"><value><text>Present Stock at Hand</text></value></draw>
              <draw name="h07" w="2.04cm" h="0.60cm"><value><text>Consumption</text></value></draw>
              <draw name="h08" w="1.99cm" h="0.60cm"><value><text>Last Supplier</text></value></draw>
              <draw name="h09" w="1.66cm" h="0.60cm"><value><text>Supply Rate</text></value></draw>
              <draw name="h10" w="1.61cm" h="0.60cm"><value><text>Exchange Rate</text></value></draw>
              <draw name="h11" w="1.39cm" h="0.60cm"><value><text>Open PR</text></value></draw>
              <draw name="h12" w="1.33cm" h="0.60cm"><value><text>Open PO</text></value></draw>
              <draw name="h13" w="1.96cm" h="0.60cm"><value><text>Total Available Stock</text></value></draw>
              <draw name="h14" w="2.30cm" h="0.60cm"><value><text>Total Value</text></value></draw>
            </subform>

            <subform name="table_row" w="28.03cm" h="0.55cm" layout="row">
              <occur min="0" max="-1"/>
              <bind match="dataRef" ref="$.T_FINAL[*]"/>
              <font typeface="Courier New" size="11pt"/>
              <field name="c01" w="0.80cm" h="0.55cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.SLNO"/></field>
              <field name="c02" w="2.50cm" h="0.55cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.MATNR"/></field>
              <field name="c03" w="5.66cm" h="0.55cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.TXZ01"/></field>
              <field name="c04" w="1.14cm" h="0.55cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.MEINS"/></field>
              <field name="c05" w="2.22cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.MENGE"/></field>
              <field name="c06" w="2.40cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.LABST"/></field>
              <field name="c07" w="2.04cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.MENGE1"/></field>
              <field name="c08" w="1.99cm" h="0.55cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.NAME1"/></field>
              <field name="c09" w="1.66cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.SUPPLY_RATE"/></field>
              <field name="c10" w="1.61cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.EXCHANGE"/></field>
              <field name="c11" w="1.39cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.GV_VALUE"/></field>
              <!-- c12-c14: field names verified against the real ZTABLE_PR_PRINT
                   row structure (docs/reference_examples_z_adt_mm_pr_form) -->
              <field name="c12" w="1.33cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.LABST1"/></field>
              <field name="c13" w="1.96cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.TOTAL"/></field>
              <field name="c14" w="2.30cm" h="0.55cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.GV_VALUE1"/></field>
            </subform>

            <subform name="table_total" w="28.03cm" h="0.60cm" layout="row" presence="visible">
              <bind match="none"/>
              <font typeface="Times New Roman" size="10pt" weight="bold"/>
              <draw name="total_label" w="20.24cm" h="0.60cm">
                <para hAlign="right"/>
                <value><text>Grand Total</text></value>
              </draw>
              <field name="total_value" w="2.30cm" h="0.60cm">
                <ui><numericEdit/></ui>
                <bind match="none"/>
                <calculate>
                  <script contentType="application/x-formcalc">$ = Sum(table_row[*].c14)</script>
                </calculate>
              </field>
            </subform>

          </subform>

        </pageArea>
      </pageSet>

      <subform h="21cm" w="29.7cm"/>

    </subform>
  </template>

  <connectionSet xmlns="http://www.xfa.org/schema/xfa-connection-set/2.8/">
    <xsdConnection dataDescription="data" name="Z_MM_PR_FORM_ADT">
      <uri/>
      <rootElement>data</rootElement>
    </xsdConnection>
  </connectionSet>

  <xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/">
    <xfa:data xfa:dataNode="dataGroup"/>
  </xfa:datasets>

  <localeSet xmlns="http://www.xfa.org/schema/xfa-locale-set/2.7/">
    <locale desc="English (United States)" name="en_US">
      <calendarSymbols name="gregorian">
        <monthNames>
          <month>January</month><month>February</month><month>March</month>
          <month>April</month><month>May</month><month>June</month>
          <month>July</month><month>August</month><month>September</month>
          <month>October</month><month>November</month><month>December</month>
        </monthNames>
        <monthNames abbr="1">
          <month>Jan</month><month>Feb</month><month>Mar</month><month>Apr</month>
          <month>May</month><month>Jun</month><month>Jul</month><month>Aug</month>
          <month>Sep</month><month>Oct</month><month>Nov</month><month>Dec</month>
        </monthNames>
        <dayNames>
          <day>Sunday</day><day>Monday</day><day>Tuesday</day><day>Wednesday</day>
          <day>Thursday</day><day>Friday</day><day>Saturday</day>
        </dayNames>
        <dayNames abbr="1">
          <day>Sun</day><day>Mon</day><day>Tue</day><day>Wed</day>
          <day>Thu</day><day>Fri</day><day>Sat</day>
        </dayNames>
        <meridiemNames><meridiem>AM</meridiem><meridiem>PM</meridiem></meridiemNames>
        <eraNames><era>BC</era><era>AD</era></eraNames>
      </calendarSymbols>
      <datePatterns>
        <datePattern name="full">EEEE, MMMM D, YYYY</datePattern>
        <datePattern name="long">MMMM D, YYYY</datePattern>
        <datePattern name="med">MMM D, YYYY</datePattern>
        <datePattern name="short">M/D/YY</datePattern>
      </datePatterns>
      <timePatterns>
        <timePattern name="full">h:MM:SS A Z</timePattern>
        <timePattern name="long">h:MM:SS A Z</timePattern>
        <timePattern name="med">h:MM:SS A</timePattern>
        <timePattern name="short">h:MM A</timePattern>
      </timePatterns>
      <dateTimeSymbols>GyMdkHmsSEDFwWahKzZ</dateTimeSymbols>
      <numberPatterns>
        <numberPattern name="numeric">zzz,zzz,zz9.zzz</numberPattern>
        <numberPattern name="currency">$zzz,zzz,zz9.99</numberPattern>
        <numberPattern name="percent">zzz,zzz,zz9%</numberPattern>
      </numberPatterns>
      <numberSymbols>
        <numberSymbol name="decimal">.</numberSymbol>
        <numberSymbol name="grouping">,</numberSymbol>
        <numberSymbol name="percent">%</numberSymbol>
        <numberSymbol name="minus">-</numberSymbol>
        <numberSymbol name="zero">0</numberSymbol>
      </numberSymbols>
      <currencySymbols>
        <currencySymbol name="symbol">NGN</currencySymbol>
        <currencySymbol name="isoname">NGN</currencySymbol>
        <currencySymbol name="decimal">.</currencySymbol>
      </currencySymbols>
      <typefaces>
        <typeface name="Times New Roman"/>
        <typeface name="Courier New"/>
        <typeface name="Arial"/>
      </typefaces>
    </locale>
  </localeSet>

</xdp:xdp>
