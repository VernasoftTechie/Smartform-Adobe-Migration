               <draw h="9mm" name="header_meins" w="11.4mm" x="89.6mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Unit</text></value></draw>
               <draw h="9mm" name="header_menge" w="22.2mm" x="101mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Req Qty</text></value></draw>
               <draw h="9mm" name="header_labst" w="24mm" x="123.2mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Present Stock at Hand</text></value></draw>
