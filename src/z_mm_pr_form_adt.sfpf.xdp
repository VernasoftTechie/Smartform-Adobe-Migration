<?xml version="1.0" encoding="UTF-8"?>
<!--
  Z_MM_PR_FORM_ADT.SFPF - layout (XDP)

  RESET TO MINIMAL BASELINE (v4.0, 2026-09-12). After v3.0 and v3.1 each
  restructured the whole file and neither rendered, and the object
  itself started showing as corrupted/unresponsive in SFP, continuing to
  guess at the full design is the wrong move. This version deliberately
  strips everything down to as close to zhello_world_form_adt.sfpf.xdp
  (the ONE file confirmed rendering in this exact SFP session) as
  possible, plus exactly one bound field, so there is a real, verified,
  working starting point before anything else is added back.

  What this version has: root "data" (layout="tb") -> pageSet/pageArea
  (geometry only) + one page_body subform (layout="position", full page
  size) -> one static draw (title) + one bound field (BANFN). No image,
  no table, no scripts, no HTML/exData blocks, no conditional logic.

  The full design (logo, header block, type-of-request text, PR header
  fields, value line, watermark with JS, computed date line, page
  footer, 14-column line-items table) is preserved in git history at
  commit 0b8e141 (v3.1) and docs/legacy_grab/Z_MM_PR_FORM_build_checklist.md
  - it gets added back incrementally, one piece at a time, ONLY after
  this baseline is confirmed rendering. See docs/BUILD_ISSUES_LOG.md F16.

  Before importing: delete and recreate both Z_MM_PR_FORM_ADT (form) and
  Z_MM_PR_FORM_ADT (interface) in SFP first - the previous object may be
  carrying corrupted state from repeated import cycles. z_mm_pr_form_adt.sfpi.xml
  is unchanged and still correct (all 16+2 import parameters, T_FINAL/T_TEXT
  table parameters, reference fields) - none of that is suspected broken;
  this reset is scoped to the LAYOUT only.
-->
<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">

  <config xmlns="http://www.xfa.org/schema/xci/3.0/">
    <present>
      <pdf>
        <version>1.7</version>
        <adobeExtensionLevel>8</adobeExtensionLevel>
      </pdf>
      <common>
        <template>
          <base/>
        </template>
        <locale>en_US</locale>
      </common>
      <xdp>
        <packets>*</packets>
      </xdp>
    </present>
  </config>

  <template xmlns:xliff="urn:oasis:names:tc:xliff:document:1.1" xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
    <subform layout="tb" locale="en_US" name="data" restoreState="auto">

      <pageSet>
        <pageArea name="Page1" id="Page1">
          <contentArea x="0cm" y="0cm" w="29.7cm" h="21cm"/>
          <medium stock="a4" orientation="landscape"/>
        </pageArea>
      </pageSet>

      <subform name="page_body" w="29.7cm" h="21cm" layout="position">

        <draw name="form_title" x="10cm" y="1cm" w="10cm" h="1cm">
          <font typeface="Times New Roman" size="15pt" weight="bold"/>
          <para hAlign="center"/>
          <value><text>PURCHASE REQUISITION FORM</text></value>
        </draw>

        <field name="fld_banfn" x="10cm" y="2.5cm" w="7cm" h="0.6cm">
          <ui><textEdit/></ui>
          <font typeface="Courier New" size="11pt"/>
          <bind match="dataRef" ref="$.BANFN"/>
        </field>

      </subform>

    </subform>
  </template>

  <connectionSet xmlns="http://www.xfa.org/schema/xfa-connection-set/2.8/">
    <xsdConnection dataDescription="data" name="Z_MM_PR_FORM_ADT">
      <uri/>
      <rootElement>data</rootElement>
    </xsdConnection>
  </connectionSet>

  <xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/">
    <xfa:data xfa:dataNode="dataGroup"/>
  </xfa:datasets>

  <localeSet xmlns="http://www.xfa.org/schema/xfa-locale-set/2.7/">
    <locale desc="English (United States)" name="en_US">
      <calendarSymbols name="gregorian">
        <monthNames>
          <month>January</month><month>February</month><month>March</month>
          <month>April</month><month>May</month><month>June</month>
          <month>July</month><month>August</month><month>September</month>
          <month>October</month><month>November</month><month>December</month>
        </monthNames>
        <monthNames abbr="1">
          <month>Jan</month><month>Feb</month><month>Mar</month><month>Apr</month>
          <month>May</month><month>Jun</month><month>Jul</month><month>Aug</month>
          <month>Sep</month><month>Oct</month><month>Nov</month><month>Dec</month>
        </monthNames>
        <dayNames>
          <day>Sunday</day><day>Monday</day><day>Tuesday</day><day>Wednesday</day>
          <day>Thursday</day><day>Friday</day><day>Saturday</day>
        </dayNames>
        <dayNames abbr="1">
          <day>Sun</day><day>Mon</day><day>Tue</day><day>Wed</day>
          <day>Thu</day><day>Fri</day><day>Sat</day>
        </dayNames>
        <meridiemNames><meridiem>AM</meridiem><meridiem>PM</meridiem></meridiemNames>
        <eraNames><era>BC</era><era>AD</era></eraNames>
      </calendarSymbols>
      <datePatterns>
        <datePattern name="full">EEEE, MMMM D, YYYY</datePattern>
        <datePattern name="long">MMMM D, YYYY</datePattern>
        <datePattern name="med">MMM D, YYYY</datePattern>
        <datePattern name="short">M/D/YY</datePattern>
      </datePatterns>
      <timePatterns>
        <timePattern name="full">h:MM:SS A Z</timePattern>
        <timePattern name="long">h:MM:SS A Z</timePattern>
        <timePattern name="med">h:MM:SS A</timePattern>
        <timePattern name="short">h:MM A</timePattern>
      </timePatterns>
      <dateTimeSymbols>GyMdkHmsSEDFwWahKzZ</dateTimeSymbols>
      <numberPatterns>
        <numberPattern name="numeric">zzz,zzz,zz9.zzz</numberPattern>
        <numberPattern name="currency">$zzz,zzz,zz9.99</numberPattern>
        <numberPattern name="percent">zzz,zzz,zz9%</numberPattern>
      </numberPatterns>
      <numberSymbols>
        <numberSymbol name="decimal">.</numberSymbol>
        <numberSymbol name="grouping">,</numberSymbol>
        <numberSymbol name="percent">%</numberSymbol>
        <numberSymbol name="minus">-</numberSymbol>
        <numberSymbol name="zero">0</numberSymbol>
      </numberSymbols>
      <currencySymbols>
        <currencySymbol name="symbol">NGN</currencySymbol>
        <currencySymbol name="isoname">NGN</currencySymbol>
        <currencySymbol name="decimal">.</currencySymbol>
      </currencySymbols>
      <typefaces>
        <typeface name="Times New Roman"/>
        <typeface name="Courier New"/>
        <typeface name="Arial"/>
      </typefaces>
    </locale>
  </localeSet>

</xdp:xdp>
