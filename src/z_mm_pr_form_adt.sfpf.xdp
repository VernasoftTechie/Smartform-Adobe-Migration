               <script contentType="application/x-javascript">this.rawValue = "Page " + xfa.layout.absPage(this) + " of " + xfa.layout.pageCount();</script>
            </event>
            <ui><textEdit/></ui>
            <font size="10pt" typeface="Times New Roman" weight="bold" posture="italic"/>
