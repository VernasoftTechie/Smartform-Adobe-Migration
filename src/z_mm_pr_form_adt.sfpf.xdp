               <draw h="9mm" name="header_supply_rate" w="16.6mm" x="187.5mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Supply Rate</text></value></draw>
               <draw h="9mm" name="header_exchange" w="16.1mm" x="204.1mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Exchange Rate</text></value></draw>
               <draw h="9mm" name="header_gv_value" w="13.9mm" x="220.2mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Open PR</text></value></draw>
               <draw h="9mm" name="header_labst1" w="13.3mm" x="234.1mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Open PO</text></value></draw>
               <draw h="9mm" name="header_total" w="19.6mm" x="247.4mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Total Available Stock</text></value></draw>
               <draw h="9mm" name="header_gv_value1" w="23mm" x="267mm" y="0mm"><font size="10pt" typeface="Times New Roman" weight="bold"/><value><text>Total Value</text></value></draw>
            </subform>
