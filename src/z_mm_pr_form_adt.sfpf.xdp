               <occur min="0" max="-1"/>
               <bind match="dataRef" ref="$.T_FINAL.DATA[*]"/>
               <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
               <field h="6mm" name="slno" w="8mm" x="0mm" y="0mm"><ui><textEdit/></ui><font size="10pt" typeface="Courier New"/><bind match="dataRef" ref="SLNO"/></field>
