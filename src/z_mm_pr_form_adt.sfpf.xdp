         <subform h="88mm" layout="position" name="watermark" presence="hidden" w="205mm" x="22mm" y="104mm">
            <event activity="initialize" name="initialize">
               <script contentType="application/x-javascript">var releaseStatus = this.parent.resolveNode("release_status");
this.presence = releaseStatus &amp;&amp; (releaseStatus.rawValue === "R" || releaseStatus.rawValue === "2") ? "visible" : "hidden";</script>
            </event>
            <draw h="25mm" name="approved_pr_watermark" w="205mm" x="0mm" y="30mm">
               <font size="69pt" typeface="Courier New" weight="bold"/>
