/></border><value><decimal fracDigits="2"/></value><format><picture>num{z,zzz,zzz,zz9.99}</picture></format><bind match="dataRef" ref="$.TBTWR"/><connect connection="ZMMET_PO_SF_ADT" ref="$.TBTWR" usage="importOnly"/></field><field locale="de_DE" minH="4.177mm" name="NETWR" w="27.9mm"><ui><numericEdit><border presence="hidden"/><margin/></numericEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="1.23mm" topInset="0.5mm"/><para hAlign="right" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><value><decimal fracDigits="2"/></value><format><picture>num{z,zzz,zzz,zz9.99}</picture></format><bind match="dataRef" ref="$.NETWR"/><connect connection="ZMMET_PO_SF_ADT" ref="$.NETWR" usage="importOnly"/></field><occur max="-1" min="0"/><bind match="dataRef" ref="$.DATA[*]"/><connect connection="ZMMET_PO_SF_ADT" ref="$.DATA" usage="importOnly"/></subform><overflow leader="HeaderRow"/><bind match="dataRef" ref="$record.GT_SERVICE_PO"/><connect connection="ZMMET_PO_SF_ADT" ref="$.GT_SERVICE_PO" usage="importOnly"/></subform><subform columnWidths="190mm" layout="table" name="ROW5"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name="E0" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border></draw><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW6"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name="E0" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" r