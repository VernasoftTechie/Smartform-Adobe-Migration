mm" name="HEADING" w="121mm" x="0mm" y="0.59mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="28pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" lineHeight="10mm" vAlign="top"/><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
if (s eq "ZPOR") then $ = "Release Order"
elseif (s eq "ZPOC") then $ = "Cash Purchase Order"
elseif (s eq "ZPOL") then $ = "Local Purchase Order"
elseif (s eq "ZPOI") then $ = "Import Purchase Order"
elseif (s eq "YCAP") then $ = "Capex Purchase Order"
elseif (s eq "YRAW") then $ = "Purchase Order"
elseif (s eq "ZPOS") then $ = "Service Purchase Order"
elseif (s eq "ZPOT" or s eq "ZPIC") then $ = "Stock Transfer PO"
else $ = ""
endif</script></calculate><bind match="none"/></field><field h="10mm" name="GV_EBELN_OUT" w="121mm" x="0mm" y="13.59mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="28pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" lineHeight="10mm" vAlign="top"/><bind match="dataRef" ref="$record.GV_EBELN_OUT"/><connect connection="ZMMET_PO_SF_ADT" ref="$.GV_EBELN_OUT" usage="importOnly"/></field><bind match="none"/></subform><subform h="42.3mm" name="DELVRY_ADD" w="47mm" x="154.5mm" y="6.7mm" layout="position"><draw h="3.387mm" name="DELIVERY_ADDRESS" w="47mm" x="0mm" y="0mm"><ui><textEdit/></ui><value><text>Delivery Address:</text></value><font size="11pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.35mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><field h="38.913mm" name="TEXT3" w="47mm" x="0mm" y="3.387mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><calculate><script contentType="application/x-formcalc">$ = Concat($record.V_COMPANY_NAME.value, "\u000a", $record.LS_DADRC_NAME1.value, "\u000a", $record.LS_DADRC_NAME2.value, "\u000a", $record.LS_DADRC_STREET.value, "\u000a", $record.LS_DADRC_CITY1.value, "\u000a", $record.LS_DADRC_POST_CODE1.value, "\u000a", $record.LS_DADRC_TEL_NUMBER.value, "\u000a", $record.LS_DADRC_FAX_NUMBER.value)</script></calculate><bind match="none"/></field><bind match="none"/></subform><subform h="61.1mm" name="SUPPLIER_ADD" w="110mm" x="0mm" y="45mm" layout="position"><subform h="61.1mm" name="FOR_ZPOT" w="101.3mm" x="0mm" y="0mm" layout="position"><draw h="4.7mm" name="LBL1" w="35mm" x="0mm" y="0mm"><ui><textEdit/></ui><value><text>SAP 