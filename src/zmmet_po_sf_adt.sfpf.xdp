m 43.3mm 31.7mm" layout="table" name="ROW13"><subform layout="row" name="Row1"><assist role="TR"/><draw minH="0mm" name="E0" w="115mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/><edge thickness="0.75pt"/></border></draw><draw minH="4.36mm" name="E1" w="43.3mm"><ui><textEdit/></ui><value><text>VAT</text></value><font size="11pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="right" lineHeight="4.36mm" vAlign="top"/></draw><field locale="de_DE" minH="4.36mm" name="LV_KWERT1" w="31.7mm"><ui><numericEdit><border presence="hidden"/><margin/></numericEdit></ui><font size="11pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="1.23mm" topInset="0.5mm"/><para hAlign="right" lineHeight="4.36mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge presence="hidden"/></border><value><decimal fracDigits="2"/></value><format><picture>num{z,zzz,zzz,zz9.99}</picture></format><bind match="dataRef" ref="$record.LV_KWERT1"/><connect connection="ZMMET_PO_SF_ADT" ref="$.LV_KWERT1" usage="importOnly"/></field><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="115mm 43.3mm 31.7mm" layout="table" name="ROW14"><subform layout="row" name="Row1"><assist role="TR"/><draw minH="0mm" name="E0" w="115mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/><edge thickness="0.75pt"/></border></draw><draw minH="4.36mm" name="E1" w="43.3mm"><ui><textEdit/></ui><value><text>Total</text></value><font size="11pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="right" lineHeight="4.36mm" vAlign="top"/></draw><field locale="de_DE" minH="4.36mm" name="TOTAL" w="31.7mm"><ui><numericEdit><border presence="hidden"/><margin/></numericEdit></ui><font size="11pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="1.23mm" topInset="0.5mm"/><para hAlign="right" lineHeight="4.36mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge presence="hidden"/></border><value><decimal fracDigits="2"/></value><format><picture>num{z,zzz,zzz,zz9.99}</picture></format><bind match="dataRef" ref="$record.TOTAL"/><connect connection="ZMMET_PO_SF_ADT" ref="$.TOTAL" usage="importOnly"/></field><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW16"><subform layout="row" name="Row1"><assist role="TR"/><field minH="4.177mm" name="WORDS" w="190mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><calculate><script contentType="application/x-formcalc">var o = "order"
var s = $record.V_BSART.value
if (s eq "ZIMP" or s eq "ZLOC") then o = "Order" endif
$ = Concat("Total ", o, " Value In Words(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value, " basis")</script></calculate><bind match="none"/></field><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW15"><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><subform layout="row" name="DATA"><assist role="TR"/><field minH="3.387mm" name="TDLINE" w="190mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><bind match="dataRef" ref="$.TDLINE"/><connect connection="ZMMET_PO_SF_ADT" ref="$.TDLINE" usage="importOnly"/></field><occur max="-1" min="0"/><bind match="dataRef" ref="$.DATA[*]"/><connect connection="ZMMET_PO_SF_ADT" ref="$.DATA" usage="importOnly"/></subform><event activity="ready" name="event__ready" ref="$form"><script contentType="application/x-formcalc">if (not (Exists($record.GT_TERMS_TEXT.DATA) and $record.V_BSART.value eq "ZPOS")) then $.presence = "hidden" endif</script></event><bind match="dataRef" ref="$record.GT_TERMS_TEXT"/><connect connection="ZMMET_PO_SF_ADT" ref="$.GT_TERMS_TEXT" usage="importOnly"/></subform><subform columnWidths="190mm" layout="table" name="ROW15_TC"><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><subform layout="row" name="TC1"><assist role="TR"/><draw minH="3.387mm" name="TC1" w="190mm"><ui><textEdit/></ui><value><text>Purchase Order Terms &amp; Conditions:</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC2"><assist role="TR"/><draw h="3.387mm" name="TC2" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC3"><assist role="TR"/><draw minH="3.387mm" name="TC3" w="190mm"><ui><textEdit/></ui><value><text>1) Prices expressed are based on Ethiopia Birr (ETB).</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC4"><assist role="TR"/><draw minH="3.387mm" name="TC4" w="190mm"><ui><textEdit/></ui><value><text>2) All orders placed with Dangote Industries Ethiopia Ltd are at all times subject to the general terms and conditions of purchase, a copy of which has been provided to you, or is available on request.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC5"><assist role="TR"/><draw minH="3.387mm" name="TC5" w="190mm"><ui><textEdit/></ui><value><text>3) Unit Prices are exclusive of Value Added Tax (VAT).</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC6"><assist role="TR"/><draw minH="3.387mm" name="TC6" w="190mm"><ui><textEdit/></ui><value><text>4) The SAP Purchase order number must be reflected on all invoices to effect payment.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC7"><assist role="TR"/><draw minH="3.387mm" name="TC7" w="190mm"><ui><textEdit/></ui><value><text>5) This is a system generated Purchase Order and does not require any signature.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC8"><assist role="TR"/><draw minH="3.387mm" name="TC8" w="190mm"><ui><textEdit/></ui><value><text>6) Any additional or different terms, whether or not materially different, set forth in any communication from the Supplier are objected to and are hereby rejected.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC9"><assist role="TR"/><draw minH="3.387mm" name="TC9" w="190mm"><ui><textEdit/></ui><value><text>7) Payment terms, strictly 30 days nett from date of statement unless otherwise agreed as per signed contractual agreement.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC10"><assist role="TR"/><draw minH="3.387mm" name="TC10" w="190mm"><ui><textEdit/></ui><value><text>8) Where goods are within guarantee/warranty, the relevant certificate of guarantee/warranty needs to accompany this Purchase Order.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><subform layout="row" name="TC11"><assist role="TR"/><draw minH="3.387mm" name="TC11" w="190mm"><ui><textEdit/></ui><value><text>9) Any other regulatory certificate e.g. Waste Disposal, needs to be current and must accompany this Purchase Order.</text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/></draw><bind match="none"/></subform><event activity="ready" name="event__ready" ref="$form"><script contentType="application/x-formcalc">if (not (not Exists($record.GT_TERMS_TEXT.DATA) and $record.V_BSART.value eq "ZPOS")) then $.presence = "hidden" endif</script></event><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW23"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name="E0" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border></draw><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW22"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name="E0" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border></draw><bind match="none"/></subform><bind match="none"/></subform><subform columnWidths="190mm" layout="table" name="ROW25"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name=