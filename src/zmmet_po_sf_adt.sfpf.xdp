"9pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border></draw><field h="4.7mm" name="LV_VTEXT" w="50mm" x="30mm" y="32.9mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.LV_VTEXT"/><connect connection="ZMMET_PO_SF_ADT" ref="$.LV_VTEXT" usage="importOnly"/></field><draw h="4.7mm" name="LBL9" w="30mm" x="0mm" y="37.6mm"><ui><textEdit/></ui><value><text>Inco Terms</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border></draw><field h="4.7mm" name="GV_INCO1" w="50mm" x="30mm" y="37.6mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.GV_INCO1"/><connect connection="ZMMET_PO_SF_ADT" ref="$.GV_INCO1" usage="importOnly"/></field><draw h="21.7mm" name="LBL10" w="30mm" x="0mm" y="42.3mm"><ui><textEdit/></ui><value><text>Additional Comments</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border></draw><field h="21.7mm" name="VAL10" w="50mm" x="30mm" y="42.3mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/></border><calculate><script contentType="application/x-formcalc">var s = ""
if ($record.V_POTEXT.value ne "X" and Exists($record.LT_LINES.DATA)) then
  var n = $record.LT_LINES.DATA.all.length
  for i = 0 upto n - 1 do
    var d = xfa.resolveNode(Concat("$record.LT_LINES.DATA[", i, "]"))
    var f = d.TDFORMAT.value
    var t = d.TDLINE.value
    if (f eq "/*" or f eq "/:") then
      s = s
    elseif (s eq "") then
      s = t
    elseif (f eq "" or f eq " ") then
      s = Concat(s, " ", t)
    elseif (f eq "=") then
      s = Concat(s, t)
    else
      s = Concat(s, "\u000a", t)
    endif
  endfor
endif
$ = s</script></calculate><bind match="none"/></field><bind match="none"/></subform><bind match="none"/></subform><bind match="none"/></subform><subform layout="tb" name="TABLE_DATA" w="190mm"><subform layout="tb" name="COMMENTS" w="190mm"><subform columnWidths="190mm" layout="table" name="LT_LINES"><subform layout="row" name="HeaderRow"><assist role="TH"/><draw minH="4.177mm" name="TEXT292" w="190mm"><ui><textEdit/></ui><value><text>Additional Comments</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/></border></draw><occur max="-1"/><bind match="none"/></subform><subform layout="row" name="DATA"><assist role="TR"/><field minH="4.177mm" name="TDLINE" w="190mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$.TDLINE"/><connect connection="ZMMET_PO_SF_ADT" ref="$.TDLINE" usage="importOnly"/></field><occur max="-1" min="0"/><bind match="dataRef" ref="$.DATA[*]"/><connect connection="ZMMET_PO_SF_ADT" ref="$.DATA" usage="importOnly"/></subform><overflow leader="HeaderRow"/><bind match="dataRef" ref="$record.LT_LINES"/><connect connection="ZMMET_PO_SF_ADT" ref="$.LT_LINES" usage="importOnly"/></subform><subform columnWidths="190mm" layout="table" name="ROW27"><subform layout="row" name="Row1"><assist role="TR"/><draw h="3.387mm" name="TEXT293" w="190mm"><ui><textEdit/></ui><value><text/></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0mm"/><para hAlign="left" lineHeight="3.387mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/></border></draw><bind match="none"/></subform><bind match="none"/></subform><event activity="ready" name="event__ready" ref="$form"><script contentType="application/x-formcalc">if (not ($record.V_POTEXT.value eq "X")) then $.presence = "hidden" endif</script></event><bind match="none"/></subform><subform layout="tb" name="OTHER_PO" w="190mm"><subform columnWidths="11.3mm 31.4mm 64.5mm 22.2mm 11mm 23.7mm 25.9mm" layout="table" name="GT_OTHER_PO"><subform layout="row" name="HeaderRow"><assist role="TH"/><draw minH="4.177mm" name="HDR1" w="11.3mm"><ui><textEdit/></ui><value><text>Sr No</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="center" lineHeight="3.387mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border></draw><draw minH="4.177mm" name="HDR2" w="31.4mm"><ui><textEdit/></ui><value><text>Material No.</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="center" lineHeight="3.387mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border></draw><draw minH="4.177mm" name="HDR3" w="64.5mm"><ui><textEdit/></ui><value><text>Item Description</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0.29mm" leftInset="0.5mm" rightInset="0.35mm" topInset="0.5mm"/><para hAlign="center" lineHeight="3.387mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge 