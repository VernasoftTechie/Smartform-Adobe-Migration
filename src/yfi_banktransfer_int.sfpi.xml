   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>IT_XFER_DETAILS</FPPARAMETER>
      <FPPARAMETER>IS_BSIS</FPPARAMETER>
      <FPPARAMETER>IV_BANK_NAME</FPPARAMETER>
      <FPPARAMETER>IV_BANK_ACCNT</FPPARAMETER>
      <FPPARAMETER>IV_AMNT_WORDS</FPPARAMETER>
      <FPPARAMETER>IV_TRANSACTION_AMNT</FPPARAMETER>
      <FPPARAMETER>IV_CURR</FPPARAMETER>
      <FPPARAMETER>LV_WATERMARK</FPPARAMETER>
      <FPPARAMETER>LV_NAME1</FPPARAMETER>
     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>DATE</FPPARAMETER>
      <FPPARAMETER>MONTH</FPPARAMETER>
      <FPPARAMETER>LV_DATE1</FPPARAMETER>
      <FPPARAMETER>LV_DATE2</FPPARAMETER>
      <FPPARAMETER>LS_XFER_DETAILS</FPPARAMETER>
      <FPPARAMETER>LV_SERIAL</FPPARAMETER>
      <FPPARAMETER>GT_XFER_ROWS</FPPARAMETER>
      <FPPARAMETER>GV_DATE_TXT</FPPARAMETER>
      <FPPARAMETER>GV_BODY_TXT</FPPARAMETER>
      <FPPARAMETER>GV_CURR_TXT</FPPARAMETER>
      <FPPARAMETER>GV_WATERMARK_TXT</FPPARAMETER>
      <FPPARAMETER>GV_NAME1_TXT</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>clear: date, lv_date1, lv_date2.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>** Changed by Zubin on 22.04.2022 - P1 remediation</FPCLINE>
      <FPCLINE>CALL FUNCTION       "#EC CI_USAGE_OK[2469385]</FPCLINE>
      <FPCLINE>&apos;ZABF_ISP_GET_MONTH_NAME&apos;</FPCLINE>
      <FPCLINE>*****&apos;ISP_GET_MONTH_NAME&apos;</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>   DATE               = sy-datum</FPCLINE>
      <FPCLINE>    LANGUAGE           = SY-LANGU</FPCLINE>
      <FPCLINE>*   MONTH_NUMBER       = MON_NO</FPCLINE>
      <FPCLINE> IMPORTING</FPCLINE>
      <FPCLINE>*   LANGU_BACK         =</FPCLINE>
      <FPCLINE>   LONGTEXT           =  MONTH</FPCLINE>
      <FPCLINE>*   SHORTTEXT          = MONTH</FPCLINE>
      <FPCLINE> EXCEPTIONS</FPCLINE>
      <FPCLINE>   CALENDAR_ID        = 1</FPCLINE>
      <FPCLINE>   DATE_ERROR         = 2</FPCLINE>
      <FPCLINE>   NOT_FOUND          = 3</FPCLINE>
      <FPCLINE>   WRONG_INPUT        = 4</FPCLINE>
      <FPCLINE>   OTHERS             = 5</FPCLINE>
      <FPCLINE>          .</FPCLINE>
      <FPCLINE>IF SY-SUBRC &lt;&gt; 0.</FPCLINE>
      <FPCLINE>* Implement suitable error handling here</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>*CONCATENATE   month &apos;&apos; sy-datum+6(2)&apos;,&apos; sy-datum+0(4)</FPCLINE>
      <FPCLINE>*   into date.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CONCATENATE   month &apos;&apos; sy-datum+6(2)</FPCLINE>
      <FPCLINE>   into date SEPARATED BY space .</FPCLINE>
      <FPCLINE>CONCATENATE date &apos;,&apos;</FPCLINE>
      <FPCLINE>   INTO lv_date1.</FPCLINE>
      <FPCLINE>CONCATENATE lv_date1 &apos;&apos; sy-datum+0(4)</FPCLINE>
      <FPCLINE>   INTO lv_date2 SEPARATED BY space.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-7): main window, table %TABLE1 over IT_XFER_DETAILS ======================</FPCLINE>
      <FPCLINE>" The Smart Form numbered the rows with a table counter (calculation CNT -&gt; LV_SERIAL); an Adobe</FPCLINE>
      <FPCLINE>" table has no counter, so the rows are numbered here. Beneficiary: %TEXT8 (BLART = BT) /</FPCLINE>
      <FPCLINE>" %TEXT20 (BLART &lt;&gt; BT).</FPCLINE>
      <FPCLINE>DATA lv_bolt_out TYPE c LENGTH 255.</FPCLINE>
      <FPCLINE>CLEAR lv_serial.</FPCLINE>
      <FPCLINE>LOOP AT it_xfer_details INTO ls_xfer_details.</FPCLINE>
      <FPCLINE>  lv_serial = lv_serial + 1.</FPCLINE>
      <FPCLINE>  APPEND INITIAL LINE TO gt_xfer_rows ASSIGNING FIELD-SYMBOL(&lt;lfs_row&gt;).</FPCLINE>
      <FPCLINE>  WRITE lv_serial TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-slno = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-ref TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-ref = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-beneficiary = COND #( WHEN ls_xfer_details-blart = &apos;BT&apos; THEN `DANGOTE CEMENT PLC`</FPCLINE>
      <FPCLINE>                                  ELSE ls_xfer_details-name1 ).</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-banka TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-banka = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-brnch TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-brnch = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-bankl TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-bankl = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-bankn TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-bankn = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  " WRBTR: reference field declared in the form (REFFIELDS): IS_BSIS-WAERS</FPCLINE>
      <FPCLINE>  WRITE ls_xfer_details-wrbtr TO lv_bolt_out CURRENCY is_bsis-waers.</FPCLINE>
      <FPCLINE>  &lt;lfs_row&gt;-wrbtr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-7): the other printed texts, as the Smart Form printed them ================</FPCLINE>
      <FPCLINE>" BANK_ADDRESS: &amp;lv_date2(C)&amp; (date text of %CODE1, condensed)</FPCLINE>
      <FPCLINE>gv_date_txt = condense( lv_date2 ).</FPCLINE>
      <FPCLINE>" LETER_BODY: the sentence with its three continuation lines joined by a blank, amount (C) condensed</FPCLINE>
      <FPCLINE>WRITE iv_transaction_amnt TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_body_txt = |Kindly use this letter as an authority to debit our { iv_bank_name } { iv_bank_accnt } | &amp;&amp;</FPCLINE>
      <FPCLINE>              |with the sum of { iv_curr } { condense( lv_bolt_out ) } ( { iv_amnt_words }) | &amp;&amp;</FPCLINE>
      <FPCLINE>              |and transfer to the beneficiary(ies) detailed below :|.</FPCLINE>
      <FPCLINE>" %TABLE1 heading of the amount column: [&amp;iv_curr&amp;]</FPCLINE>
      <FPCLINE>gv_curr_txt = |[{ iv_curr }]|.</FPCLINE>
      <FPCLINE>" WATERMARK window %TEXT17 (LV_WATERMARK = X: reprint)</FPCLINE>
      <FPCLINE>gv_watermark_txt = COND #( WHEN lv_watermark = &apos;X&apos; THEN `Re-Printed` ).</FPCLINE>
      <FPCLINE>" table footer %TEXT18: &amp;lv_name1(C)&amp;</FPCLINE>
      <FPCLINE>gv_name1_txt = condense( lv_name1 ).</FPCLINE>
     </INITIALIZATION>
     <FORMS/>
    </CL_FP_CODING>
   </cls:CL_FP_CODING>
  </asx:heap>
 </asx:abap>
