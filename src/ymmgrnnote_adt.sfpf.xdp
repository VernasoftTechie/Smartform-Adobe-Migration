<?xml version="1.0" encoding="utf-8"?>
<?xfa generator="AdobeLiveCycleDesigner_V11.0.9.20240701.1.52_SAP" APIVersion="3.6.24183.0"?><xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/" timeStamp="2026-09-12T19:37:33Z" uuid="0fa629a9-14e9-4ec1-b81a-3a612fcc253b">
<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
   <?formServer defaultPDFRenderFormat acrobat10.0dynamic?>
   <subform layout="tb" locale="en_IN" name="data" restoreState="auto">
      <pageSet>
         <pageArea id="Page1" name="Page1">
            <contentArea h="29.7cm" w="21cm" x="0cm" y="0cm"/>
            <medium long="29.7cm" short="21cm" stock="a4"/>
            <?templateDesigner expand 1?></pageArea>
         <?templateDesigner expand 1?></pageSet>
      <subform h="29.7cm" layout="position" name="visual_shell" w="21cm">
         <!-- Logo: SE78 GRAPHICS/DANOGATELOGONEW/BMAP/BCOL per
              docs/legacy_grab/ymmgrnnote.md section 1 and the global
              logo inventory. Position is a reasonable top-left default,
              not evidenced - the legacy XML's own window coordinates are
              blank (checklist item 3); confirm against a real printed
              GRN before treating this as final. -->
         <field h="2.2cm" name="logo_image" w="4.5cm" x="1cm" y="1cm">
            <ui><imageEdit/></ui>
            <bind match="none"/>
            <value>
               <image contentType="image/bmp" href="/sap/bc/fp/graphics/public/graphics/bmap/bcol/DANOGATELOGONEW.bmp"/>
            </value>
         </field>
         <draw h="0.9cm" name="legacy_caption" w="21cm" x="0cm" y="3.4cm">
            <value>
               <text>Goods Reciept Note</text>
            </value>
            <font size="14pt" typeface="Arial" weight="bold"/>
            <para hAlign="center"/>
         </draw>
         <!-- GRN No / Date - evidence: ymmgrnnote.md section 3, DATE
              window: "GRN NO. &LS_MKPF-MBLNR&" / "GRN Date:
              &LS_MKPF-BUDAT&". Binding test: MBLNR only, to confirm the
              $.LS_MKPF.<field> addressing convention against the real
              captured Context before binding every other field the same
              way - the Context capture showed both a bare BUDAT and a
              BUDAT_MKPF at different tree positions, not yet resolved
              which this form's own LS_MKPF-BUDAT actually maps to. -->
         <subform h="0.6cm" layout="row" name="grn_no_line" w="10cm" x="1cm" y="4.6cm">
            <bind match="none"/>
            <draw h="0.6cm" name="lbl_grn_no" w="2.5cm">
               <value><text>GRN NO.</text></value>
               <font size="10pt" typeface="Arial" weight="bold"/>
            </draw>
            <field h="0.6cm" name="fld_mblnr" w="4cm">
               <ui><textEdit/></ui>
               <font size="10pt" typeface="Arial"/>
               <bind match="dataRef" ref="$.LS_MKPF.MBLNR"/>
            </field>
         </subform>
         <!-- GRN Date - evidence: ymmgrnnote.md section 3, DATE window
              "GRN Date: &LS_MKPF-BUDAT&". Bound to bare BUDAT (MKPF's
              own standard posting-date field) as the most likely match;
              the captured Context also showed a BUDAT_MKPF at a
              different tree position whose owner is not yet confirmed -
              verify this binding renders the right value before trusting
              it, per F33. -->
         <subform h="0.6cm" layout="row" name="grn_date_line" w="10cm" x="1cm" y="5.3cm">
            <bind match="none"/>
            <draw h="0.6cm" name="lbl_grn_date" w="2.5cm">
               <value><text>GRN Date:</text></value>
               <font size="10pt" typeface="Arial" weight="bold"/>
            </draw>
            <field h="0.6cm" name="fld_budat" w="4cm">
               <ui><textEdit/></ui>
               <font size="10pt" typeface="Arial"/>
               <bind match="dataRef" ref="$.LS_MKPF.BUDAT"/>
            </field>
         </subform>
         <!-- Company/plant identity - evidence: ymmgrnnote.md section 3,
              HEADERWINDOW: dynamic LV_BUTXT (company name, already
              computed in CL_FP_CODING/INITIALIZATION) and
              LS_T001W-NAME1/STRAS/PFACH/ORT01 (plant address). This is
              the ALWAYS-CORRECT real-data version, deliberately not the
              5-way conditional Dangote/Okpella static-text branching
              (DEP-YMMGRNNOTE-05, %CONDITION1/2/3/5/7/8 per
              ymmgrnnote_interface_scope_ledger.md) - that needs full
              business sign-off on condition precedence and exact wording
              before it replaces this real-data default, per build
              checklist item 6 ("keep every conditional branch visibly
              annotated until DEP-YMMGRNNOTE-05 is approved"). -->
         <subform h="1.8cm" layout="position" name="company_identity" w="14cm" x="1cm" y="6.1cm">
            <bind match="none"/>
            <field h="0.5cm" name="fld_company" w="14cm" x="0cm" y="0cm">
               <ui><textEdit/></ui>
               <font size="11pt" typeface="Arial" weight="bold"/>
               <bind match="dataRef" ref="$.LV_BUTXT"/>
            </field>
            <field h="0.5cm" name="fld_plant_name" w="14cm" x="0cm" y="0.5cm">
               <ui><textEdit/></ui>
               <font size="10pt" typeface="Arial"/>
               <bind match="dataRef" ref="$.LS_T001W.NAME1"/>
            </field>
            <subform h="0.5cm" layout="row" name="plant_address_line" x="0cm" y="1cm">
               <bind match="none"/>
               <field h="0.5cm" name="fld_plant_stras" w="6cm">
                  <ui><textEdit/></ui>
                  <font size="10pt" typeface="Arial"/>
                  <bind match="dataRef" ref="$.LS_T001W.STRAS"/>
               </field>
               <field h="0.5cm" name="fld_plant_pfach" w="3cm">
                  <ui><textEdit/></ui>
                  <font size="10pt" typeface="Arial"/>
                  <bind match="dataRef" ref="$.LS_T001W.PFACH"/>
               </field>
               <field h="0.5cm" name="fld_plant_ort01" w="5cm">
                  <ui><textEdit/></ui>
                  <font size="10pt" typeface="Arial"/>
                  <bind match="dataRef" ref="$.LS_T001W.ORT01"/>
               </field>
            </subform>
         </subform>
         <!-- TEMPLATE window - evidence: byte-offset extracted from
              ymmgrnnote.xml, nodes %TEXT3 (column 1, 10.66cm) and %TEXT4
              (column 2, 9.54cm) under %TEMPLATE1 (total 20.20cm, matching
              build checklist item 3's exact width). Every label/field
              pairing below is the literal legacy text, typos preserved
              (WAY_BII_NO, VEND_INV, Loding) since these may be the real
              customer field names, not to be silently corrected. -->
         <!-- Overflow fix (v2->v3): template_block was at x=1cm with
              w=20.20cm, overflowing the 21cm page by 0.2cm. Centered:
              x=0.4cm, 0.4+20.20+0.4=21.0cm exactly.

              Density fix (this round, per explicit request - "reduce
              the font styles ... show max possible details, since it's
              a template we stick to how much we can show"): the earlier
              9pt attempt needed ever-taller rows to avoid wrapping/
              clipping (F36, F37), fighting the font size instead of
              just reducing it. Dropped to 7pt, which lets every label -
              including the two long "Air Way Bill" ones - fit on a
              single line within its existing width, so every row goes
              back to one compact, uniform height (0.5cm) instead of
              needing per-row exceptions. template_col1 (9 rows) is
              4.5cm tall, template_col2 (8 rows) is 4.0cm - template_block
              sized to the taller of the two. -->
         <subform h="4.8cm" layout="position" name="template_block" w="20.20cm" x="0.4cm" y="8.3cm">
            <bind match="none"/>
            <subform h="4.5cm" layout="tb" name="template_col1" w="10.66cm" x="0cm" y="0cm">
               <bind match="none"/>
               <font size="7pt" typeface="Arial"/>
               <subform h="0.5cm" layout="row" name="tpl_supplier"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_supplier" w="5.5cm"><value><text>Name of the Supplier:</text></value></draw>
                  <field h="0.5cm" name="fld_supplier" w="5.16cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_LFA1.NAME1"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_waybill"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_waybill" w="5.5cm"><value><text>Way Bill No. and Date:</text></value></draw>
                  <field h="0.5cm" name="fld_waybill_no" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.WAY_BII_NO"/></field>
                  <field h="0.5cm" name="fld_waybill_dt" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.WAY_BIL_DT"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_invoice"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_invoice" w="5.5cm"><value><text>Invoice No and Date:</text></value></draw>
                  <field h="0.5cm" name="fld_invoice_no" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.VENDOR_INV"/></field>
                  <field h="0.5cm" name="fld_invoice_dt" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.VEND_INV"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_transporter"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_transporter" w="5.5cm"><value><text>Transporter Name:</text></value></draw>
                  <field h="0.5cm" name="fld_transporter" w="5.16cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.TRANSPORTER"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_vehicle"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_vehicle" w="5.5cm"><value><text>Vehicle No:</text></value></draw>
                  <field h="0.5cm" name="fld_vehicle" w="5.16cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.VEHICLE_NO"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_lpr"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_lpr" w="5.5cm"><value><text>LPR No. and Date:</text></value></draw>
                  <field h="0.5cm" name="fld_lpr_no" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EBAN.BANFN"/></field>
                  <field h="0.5cm" name="fld_lpr_dt" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EBAN.BADAT"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_lpo"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_lpo" w="5.5cm"><value><text>LPO No. and Date:</text></value></draw>
                  <field h="0.5cm" name="fld_lpo_no" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.EBELN"/></field>
                  <field h="0.5cm" name="fld_lpo_dt" w="2.58cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EKKO.BEDAT"/></field>
               </subform>
               <!-- Evidence literally reads "&ls_eban-MFRPN&" for
                    "Department Name" - MFRPN (Manufacturer Part Number)
                    is an unusual field for a department, but preserved
                    exactly as evidenced rather than substituted; flag for
                    functional-owner confirmation, not silently changed. -->
               <subform h="0.5cm" layout="row" name="tpl_department"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_department" w="5.5cm"><value><text>Department Name:</text></value></draw>
                  <field h="0.5cm" name="fld_department" w="5.16cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EBAN.MFRPN"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_section"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_section" w="5.5cm"><value><text>Section Name or Code:</text></value></draw>
                  <field h="0.5cm" name="fld_section" w="5.16cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_EBAN.BEDNR"/></field>
               </subform>
            </subform>
            <!-- template_col2 height raised 4.0->4.8cm: the two rows
                 below are 0.9cm instead of the uniform 0.5cm (see their
                 own comment). -->
            <subform h="4.8cm" layout="tb" name="template_col2" w="9.54cm" x="10.66cm" y="0cm">
               <bind match="none"/>
               <font size="7pt" typeface="Arial"/>
               <!-- These two labels are the outliers: even at 7pt they
                    don't fit 6cm on one line (confirmed - every other
                    label in this template does fit at 7pt/0.5cm, only
                    these two still showed the overflow "+" badge).
                    Rather than keep shrinking font project-wide for two
                    labels, or truncating the evidenced legacy wording,
                    give exactly these two rows enough height (0.9cm) to
                    show their natural two-line wrap cleanly. -->
               <subform h="0.9cm" layout="row" name="tpl_awb_no"><bind match="none"/>
                  <draw h="0.9cm" name="lbl_awb_no" w="6cm"><value><text>Air Way Bill No/Bill of Loding No:</text></value></draw>
                  <field h="0.9cm" name="fld_awb_no" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.AWB_NO_BOL"/></field>
               </subform>
               <subform h="0.9cm" layout="row" name="tpl_awb_dt"><bind match="none"/>
                  <draw h="0.9cm" name="lbl_awb_dt" w="6cm"><value><text>Air Way Bill/Bill of Loading Date:</text></value></draw>
                  <field h="0.9cm" name="fld_awb_dt" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.AWB_DT_BOL"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_ship"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_ship" w="6cm"><value><text>Name of Ship/Flight:</text></value></draw>
                  <field h="0.5cm" name="fld_ship" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.SHIP_FLIGHT"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_clearing"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_clearing" w="6cm"><value><text>Name of Clearing Agent:</text></value></draw>
                  <field h="0.5cm" name="fld_clearing" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.CLEAR_AGNT"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_lc"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_lc" w="6cm"><value><text>Letter of Credit(LC)No:</text></value></draw>
                  <field h="0.5cm" name="fld_lc" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.LC_NO"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_formm"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_formm" w="6cm"><value><text>Form M No:</text></value></draw>
                  <field h="0.5cm" name="fld_formm" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.FORM_M"/></field>
               </subform>
               <subform h="0.5cm" layout="row" name="tpl_container"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_container" w="6cm"><value><text>Container No. or Mark No:</text></value></draw>
                  <field h="0.5cm" name="fld_container" w="3.54cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.LS_MKPF.CONTAINER"/></field>
               </subform>
               <!-- $.IV_WAERS / $.IV_KURSF are bare - both are top-level
                    interface import parameters, not nested under any
                    structure, matching the pilot's own $.V_WAERS
                    convention. -->
               <subform h="0.5cm" layout="row" name="tpl_currency"><bind match="none"/>
                  <draw h="0.5cm" name="lbl_currency" w="6cm"><value><text>Currency/Exchange Rate:</text></value></draw>
                  <field h="0.5cm" name="fld_waers" w="1.5cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.IV_WAERS"/></field>
                  <field h="0.5cm" name="fld_kursf" w="2.04cm"><ui><numericEdit/></ui><bind match="dataRef" ref="$.IV_KURSF"/></field>
               </subform>
            </subform>
         </subform>
      </subform>
      <proto/>
      <desc>
         <text name="version">11.0.9.20240701.1.52.2</text>
      </desc>
      <?templateDesigner expand 1?></subform>
   <?templateDesigner DefaultPreviewDynamic 1?>
   <?templateDesigner DefaultRunAt client?>
   <?templateDesigner Grid show:1, snap:1, units:0, color:ff8080, origin:(0,0), interval:(125000,125000)?>
   <?templateDesigner FormTargetVersion 33?>
   <?templateDesigner WidowOrphanControl 0?>
   <?templateDesigner DefaultCaptionFontSettings face:Arial;size:10;weight:normal;style:normal?>
   <?templateDesigner DefaultValueFontSettings face:Arial;size:10;weight:normal;style:normal?>
   <?templateDesigner DefaultLanguage JavaScript?>
   <?acrobat JavaScript strictScoping?>
   <?templateDesigner Rulers horizontal:1, vertical:1, guidelines:1, crosshairs:0?>
   <?templateDesigner Zoom 125?></template>
