<subform h="135mm" layout="position" name="HEADER_AREA" w="202mm">
  <field h="7mm" name="HEADING" x="11.2mm" y="11.447mm" w="141mm"><ui><textEdit/></ui><font size="18pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" vAlign="top"/><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
var lg = "E"
if (s eq "ZPOL" or s eq "ZPOS" or (s ne "ZPOI" and $record.GV_LANGU.value eq "F")) then lg = "F" endif
$ = ""
if (($record.V_BSART.value eq "ZPOR")) then
  if (lg eq "F") then $ = "BON DE COMMANDE / RELEASE" else $ = "RELEASE ORDER" endif
endif
if (($record.V_BSART.value eq "ZPOC")) then
  if (lg eq "F") then $ = "BON DE COMMANDE / CASH" else $ = "CASH PURCHASE ORDER" endif
endif
if (($record.V_BSART.value eq "ZPOL")) then
  $ = "BON DE COMMANDE / LOCAL"
endif
if (($record.V_BSART.value eq "ZPOI")) then
  $ = "IMPORT PURCHASE ORDER"
endif
if (($record.V_BSART.value eq "YCAP")) then
  if (lg eq "F") then $ = "CAPEX PURCHASE ORDER" else $ = "Capex Purchase Order" endif
endif
if (($record.V_BSART.value eq "YRAW")) then
  $ = "PURCHASE ORDER"
endif
if (($record.V_BSART.value eq "ZPOS")) then
  if (lg eq "F") then $ = "BON DE COMMANDE / SERVICE" else $ = "SERVICE PURCHASE ORDER" endif
endif
if (($record.V_BSART.value eq "ZPOT" or $record.V_BSART.value eq "ZPIC")) then
  $ = "STOCK TRANSFER PO"
endif</script></calculate><bind match="none"/></field>
  <field h="7mm" name="V_EBELN" x="11.2mm" y="24.447mm" w="141mm"><ui><textEdit/></ui><font size="18pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/><para hAlign="center" vAlign="top"/><bind match="dataRef" ref="$record.V_EBELN"/><connect connection="ZMMCG_PO_SF_ADT" ref="$.V_EBELN" usage="importOnly"/></field>
