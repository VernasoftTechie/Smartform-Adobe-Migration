                        <script contentType="application/x-javascript">var f = this.parent.resolveNode("f_bsart");
                        var v = f ? f.rawValue : "";
                        var l = ""; try { var fl = this.parent.resolveNode("f_langu"); l = fl ? fl.rawValue : ""; } catch (e) { l = ""; }
                        this.presence = (v !== "ZPOS") ? "visible" : "hidden";</script>
                     </event>
                     <draw minH="0.5cm" name="folder4_F_term1_t" w="18.1cm" x="0cm" y="0cm">
                        <value><text>Les prix exprimés sont basés sur un prix de livraison au Cameroun.</text></value>
                        <font size="8pt" typeface="Arial"/>
                        <para vAlign="top"/>
                     </draw>
                  </subform>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_F_term2" w="19cm">
