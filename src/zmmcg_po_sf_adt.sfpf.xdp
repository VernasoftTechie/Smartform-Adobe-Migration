                  <field h="1mm" name="f_inco1" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.GV_INCO1"/></field>
                  <field h="1mm" name="f_inco2" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.GV_INCO2"/></field>
                  <field h="1mm" name="f_waers" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.V_WAERS"/></field>
                  <field h="1mm" name="f_langu" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.GV_LANGU"/></field>
                  <field minH="0.6cm" name="g_f_words_txt" w="19cm" x="0cm" y="0cm">
                     <ui><textEdit multiLine="1"/></ui>
                     <bind match="none"/>
                     <event activity="initialize" name="initialize">
                        <script contentType="application/x-javascript">var p = this.parent;
                        function g(nm) { var f = p.resolveNode(nm); return (f &amp;&amp; f.rawValue) ? String(f.rawValue) : ""; }
                        var v = g("f_bsart");
                        var lead = (v === "ZPOL") ? "Montant Total en Lettre(" : ((v === "ZIMP" || v === "ZLOC" || v === "ZPOI") ? "Total Order Value In Words(" : "Total order Value In Words(");
                        this.rawValue = lead + g("f_ktext") + "): " + g("f_words") + " " + g("f_inco1") + " " + g("f_inco2") + " basis";</script>
                     </event>
                     <font size="8pt" typeface="Arial" weight="bold"/>
                     <para vAlign="middle"/>
                     <margin bottomInset="0.05cm" leftInset="0.1cm" rightInset="0.1cm" topInset="0.05cm"/>
                     <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  </field>
               </subform>
