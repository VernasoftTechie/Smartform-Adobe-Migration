                  <draw h="0.45cm" name="g_cl_last_2" w="14cm" x="5cm" y="0cm"><border><edge presence="hidden"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border></draw>
