        <field h="4.2mm" name="C2" w="43mm"><ui><textEdit/></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0mm" rightInset="0.3mm" topInset="1.022mm"/><para hAlign="right" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/></border><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
