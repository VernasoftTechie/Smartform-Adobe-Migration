<subform layout="tb" name="TABLE_DATA" w="190mm">
  <subform layout="tb" name="COMMENTS" w="190mm">
    <subform columnWidths="190mm" layout="table" name="LT_LINES">
      <subform layout="row" name="HeaderRow">
        <assist role="TH"/>
        <draw minH="4.2mm" name="HEAD" w="190mm"><ui><textEdit/></ui><value><text>Additional Comments</text></value><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0mm" topInset="1.122mm"/><para hAlign="left" lineHeight="3.078mm" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/></border></draw>
        <occur max="-1"/>
        <bind match="none"/>
      </subform>
      <subform layout="row" name="DATA">
        <assist role="TR"/>
        <field minH="4.183mm" name="TDLINE" w="190mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0mm" topInset="1.122mm"/><para hAlign="left" lineHeight="3.061mm" vAlign="top"/><border><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$.TDLINE"/><connect connection="ZMMCG_PO_SF_ADT" ref="$.TDLINE" usage="importOnly"/></field>
        <occur max="-1" min="0"/>
        <bind match="dataRef" ref="$.DATA[*]"/><connect connection="ZMMCG_PO_SF_ADT" ref="$.DATA" usage="importOnly"/>
      </subform>
      <overflow leader="HeaderRow"/>
      <bind match="dataRef" ref="$record.LT_LINES"/><connect connection="ZMMCG_PO_SF_ADT" ref="$.LT_LINES" usage="importOnly"/>
    </subform>
    <subform columnWidths="190mm" layout="table" name="COMMENTS_END">
      <subform layout="row" name="Row1">
        <assist role="TR"/>
        <draw h="3.4mm" name="C1" w="190mm"><ui><textEdit/></ui><value><text></text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0mm" topInset="0mm"/><para hAlign="left" vAlign="top"/><border><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/><edge presence="hidden"/></border></draw>
        <bind match="none"/>
      </subform>
      <bind match="none"/>
    </subform>
    <event activity="ready" name="event__ready" ref="$form"><script contentType="application/x-formcalc">if (not (($record.V_POTEXT.value eq "X"))) then $.presence = "hidden" endif</script></event>
    <bind match="none"/>
  </subform>
