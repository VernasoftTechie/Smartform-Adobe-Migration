            <subform layout="tb" name="s_terms_en" presence="hidden" w="19cm">
               <bind match="none"/>
               <event activity="initialize" name="initialize">
                  <script contentType="application/x-javascript">var p = this.parent;
                  function g(nm) { var f = p.resolveNode(nm); return (f &amp;&amp; f.rawValue) ? String(f.rawValue) : ""; }
                  var v = g("f_bsart"); var l = g("f_langu");
                  this.presence = (v !== "ZPOI" &amp;&amp; !(v === "ZPOL" || v === "ZPOS" || l === "F")) ? "visible" : "hidden";</script>
               </event>
               <subform layout="position" minH="1.0cm" name="folder4_E_head" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw minH="1.0cm" name="folder4_E_head_t" w="19cm" x="0cm" y="0cm">
                     <value><text>&#10; Purchase Order Terms &amp; Conditions:&#10;</text></value>
                     <font size="8pt" typeface="Arial" weight="bold"/>
                     <para vAlign="middle"/>
                     <margin leftInset="0.25cm"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term1" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term1_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>1.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <field h="1mm" name="f_bsart" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.V_BSART"/></field>
                  <subform h="0.5cm" layout="position" name="folder4_E_term1_c" presence="hidden" w="18.1cm" x="0.85cm" y="0cm">
                     <bind match="none"/>
                     <event activity="initialize" name="initialize">
                        <script contentType="application/x-javascript">var f = this.parent.resolveNode("f_bsart");
                        var v = f ? f.rawValue : "";
                        var l = ""; try { var fl = this.parent.resolveNode("f_langu"); l = fl ? fl.rawValue : ""; } catch (e) { l = ""; }
                        this.presence = (v !== "ZPOS") ? "visible" : "hidden";</script>
                     </event>
                     <draw minH="0.5cm" name="folder4_E_term1_t" w="18.1cm" x="0cm" y="0cm">
                        <value><text>Prices expressed are based on a delivered price in Cameroon.</text></value>
                        <font size="8pt" typeface="Arial"/>
                        <para vAlign="top"/>
                     </draw>
                  </subform>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term2" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term2_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>2.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term2_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Unit Prices are exclusive of Value Added Tax (VAT).</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term3" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term3_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>3.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term3_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>The Purchase Order number must be reflected on all invoices to effect payment.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term4" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term4_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>4.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term4_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Payment terms, is strictly 30 days after delivery, unless otherwise agreed as per signed contractual agreement.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term5" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term5_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>5.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term5_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Guarantee/Warranty: where a guarantee/warranty, is applicable the necessary documentation most accompany the goods or services. Otherwise, as a default, the items covered under this order shall stand guarantee/warranty of 18 months from the date of supply or 12 months from the date of installation / commissioning.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term6" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term6_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>6.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term6_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Any other regulatory certificates e.g. Material Safety Data Sheet (MSDS), Operating Manuals, Waste Disposal etc., needs to be current and must accompany this Purchase Order.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term7" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term7_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>7.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term7_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Goods and/or Services would be accepted, only if it conforms to our quality and/or standard specifications.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term8" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term8_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>8.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term8_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Invoice shall be raised based on the lowest between principal vendor's weighbridge quantity and Dangote's weighbridge quantity.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term9" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_E_term9_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>9.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term9_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>All invoices must be sent to the Finance Department.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_E_term10" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
                  <draw h="0.5cm" name="folder4_E_term10_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>10.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_E_term10_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>No variation in this terms and conditions will be accepted.&#10;</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
            </subform>
