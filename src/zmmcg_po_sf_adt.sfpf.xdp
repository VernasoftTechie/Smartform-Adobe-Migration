    <subform columnWidths="190mm" layout="table" name="TOTAL_VALUE_WORDS">
      <subform layout="row" name="Row1">
        <assist role="TR"/>
        <field minH="4.2mm" name="WORDS" w="190mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0mm" topInset="1.122mm"/><para hAlign="left" lineHeight="3.078mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge presence="hidden"/><edge thickness="0.75pt"/></border><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
var lg = "E"
if (s eq "ZPOL" or s eq "ZPOS" or (s ne "ZPOI" and $record.GV_LANGU.value eq "F")) then lg = "F" endif
$ = ""
if (($record.V_BSART.value ne "ZIMP" and $record.V_BSART.value ne "ZLOC" and $record.V_BSART.value ne "ZPOL" and $record.V_BSART.value ne "ZPOI")) then
  if (lg eq "F") then $ = Concat("Montant Total en Lettre(", $record.V_WAERS.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value) else $ = Concat("Total order Value In Words(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value, " basis") endif
endif
if (($record.V_BSART.value eq "ZPOL")) then
  if (lg eq "F") then $ = Concat("Montant Total en Lettre(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, $record.GV_INCO2.value, "\u000a", "basis") else $ = Concat("Montant Total en Lettre(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value, " basis") endif
endif
if (($record.V_BSART.value eq "ZIMP" or $record.V_BSART.value eq "ZLOC")) then
  if (lg eq "F") then $ = Concat("Montant Total en Lettre(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value) else $ = Concat("Total Order Value In Words(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value, " basis") endif
endif
if (($record.V_BSART.value eq "ZPOI")) then
  if (lg eq "F") then $ = Concat("Total Order Value In Words(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value) else $ = Concat("Total Order Value In Words(", $record.LV_KTEXT.value, "): ", $record.LV_AMT_WORDS.value, " ", $record.GV_INCO1.value, " ", $record.GV_INCO2.value, " basis") endif
endif</script></calculate><bind match="none"/></field>
        <bind match="none"/>
      </subform>
      <bind match="none"/>
    </subform>
