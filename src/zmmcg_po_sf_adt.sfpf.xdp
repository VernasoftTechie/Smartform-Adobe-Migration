                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder4_F_term2_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Les Prix unitaires sont exclusivement sur la tax sur valeur ajoutée. (TVA)</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_F_term3" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_F_term3_n" w="0.55cm" x="0.25cm" y="0cm">
