                  <para hAlign="left" vAlign="middle"/>
                  <margin leftInset="0.1cm"/>
                  <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
               </draw>
            </subform>
            <subform layout="position" minH="0.45cm" name="cm_row" w="19cm">
               <occur max="-1" min="0"/>
