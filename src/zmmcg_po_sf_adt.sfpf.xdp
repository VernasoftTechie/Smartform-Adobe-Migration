        <field h="7.6mm" name="H7" w="25.9mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial" weight="bold"/><margin bottomInset="0mm" leftInset="0.3mm" rightInset="0.3mm" topInset="1.122mm"/><para hAlign="center" lineHeight="3.4mm" vAlign="top"/><border><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><edge thickness="0.75pt"/><fill><color value="176,176,176"/></fill></border><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
