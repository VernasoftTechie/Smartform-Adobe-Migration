            <field h="1mm" name="f_bsart" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.V_BSART"/></field>
            <field h="1mm" name="f_langu" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.GV_LANGU"/></field>
            <subform layout="tb" name="g_terms_imp" presence="hidden" w="19cm">
               <bind match="none"/>
               <event activity="initialize" name="initialize">
                  <script contentType="application/x-javascript">var p = this.parent;
                  function g(nm) { var f = p.resolveNode(nm); return (f &amp;&amp; f.rawValue) ? String(f.rawValue) : ""; }
                  var v = g("f_bsart"); var l = g("f_langu");
                  this.presence = (v === "ZPOI") ? "visible" : "hidden";</script>
               </event>
               <subform layout="position" minH="1.0cm" name="folder1_E_head" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw minH="1.0cm" name="folder1_E_head_t" w="19cm" x="0cm" y="0cm">
                     <value><text>&#10; Purchase Order Terms &amp; Conditions:&#10;</text></value>
                     <font size="8pt" typeface="Arial" weight="bold"/>
                     <para vAlign="middle"/>
                     <margin leftInset="0.25cm"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms1" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms1_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>1.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms1_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Vendor must send one non-negotiable original Master Bill of Lading directly to applicant bank, immediately after shipment is done.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms2" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms2_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>2.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms2_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Bill of Lading/Air Way Bill Number, Commercial Invoice, Packing List, Manufacturer Certificate, CCVO (Combined Certificate for Value &amp; Origin), ECTN (Electronic Cargo Tracking Note) are mandatory documents as shipping advice to buyer and our Clearing/Logistic Department.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms3" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms3_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>3.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms3_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>L/C (Letter of Credit) Number should appear on every individual shipping documents..</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms4" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms4_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>4.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms4_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>All the Bank charges within CONGO REPUBLIC are to Buyer's account &amp; all other bank charges are to supplier's account.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms5" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms5_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>5.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms5_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>The Purchase Order number must be reflected on all invoices to effect payment. All invoices must be sent to the Finance Department.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms6" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms6_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>6.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms6_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Guarantee/Warranty: where a guarantee/warranty, is applicable the necessary documentation most accompany the goods or services. Otherwise, as a default, the items covered under this order shall stand guarantee/warranty of 18 months from the date of supply or 12 months from the date of installation / commissioning.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms7" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms7_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>7.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms7_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Any other regulatory certificates e.g. Material Safety Data Sheet (MSDS), Operating Manuals, Waste Disposal etc., needs to be current and must accompany this Purchase Order.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms8" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms8_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>8.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms8_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Logistics Manager&#10;Ste. Dangote Cement Congo SA,&#10;Quartier NDJINDJI, Vers CFAO CONGO,&#10;BP 1103, Pointe Noire,&#10;Republic of Congo&#10;Tel: +242 05 799 9383&#10;Email: DCCG-LOGISTICS@DANGOTE.COM&#10;       DCCG-PURCHASE@DANGOTE.COM</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms9" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms9_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>9.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms9_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Goods and/or Services would be accepted, only if it conforms to our quality and/or standard specifications.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms10" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder1_E_terms10_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>10.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms10_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Invoice shall be raised based on the lowest between principal vendor's weighbridge quantity and Dangote's weighbridge quantity.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder1_E_terms11" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
                  <draw h="0.5cm" name="folder1_E_terms11_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>11.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder1_E_terms11_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>No variation in this terms and conditions will be accepted.&#10;</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
            </subform>
            <subform layout="tb" name="g_terms_loc_en" presence="hidden" w="19cm">
               <bind match="none"/>
               <event activity="initialize" name="initialize">
                  <script contentType="application/x-javascript">var p = this.parent;
                  function g(nm) { var f = p.resolveNode(nm); return (f &amp;&amp; f.rawValue) ? String(f.rawValue) : ""; }
                  var v = g("f_bsart"); var l = g("f_langu");
                  this.presence = (v !== "ZPOI" &amp;&amp; !(v === "ZPOL" || v === "ZPOS" || l === "F")) ? "visible" : "hidden";</script>
               </event>
               <subform layout="position" minH="1.0cm" name="folder2_E_head" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw minH="1.0cm" name="folder2_E_head_t" w="19cm" x="0cm" y="0cm">
                     <value><text>&#10; Purchase Order Terms &amp; Conditions:&#10;</text></value>
                     <font size="8pt" typeface="Arial" weight="bold"/>
                     <para vAlign="middle"/>
                     <margin leftInset="0.25cm"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_1" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_1_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>1.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_1_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Prices expressed are based on a delivered price in Congo.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_2" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_2_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>2.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_2_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Unit Prices are exclusive of Value Added Tax (VAT).</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_3" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_3_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>3.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_3_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>The Purchase Order number must be reflected on all invoices to effect payment.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_4" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_4_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>4.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_4_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Payment terms, is strictly 30 days after delivery, unless otherwise agreed as per signed contractual agreement.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_5" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_5_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>5.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_5_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Guarantee/Warranty: where a guarantee/warranty, is applicable the necessary documentation most accompany the goods or services. Otherwise, as a default, the items covered under this order shall stand guarantee/warranty of 18 months from the date of supply or 12 months from the date of installation / commissioning.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_6" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_6_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>6.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_6_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Any other regulatory certificates e.g. Material Safety Data Sheet (MSDS), Operating Manuals, Waste Disposal etc., needs to be current and must accompany this Purchase Order.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_7" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_7_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>7.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_7_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Goods and/or Services would be accepted, only if it conforms to our quality and/or standard specifications.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_8" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_8_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>8.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_8_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Invoice shall be raised based on the lowest between principal vendor's weighbridge quantity and Dangote's weighbridge quantity.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_9" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_E_term_9_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>9.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_9_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>All invoices must be sent to the Finance Department.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_E_term_10" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
                  <draw h="0.5cm" name="folder2_E_term_10_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>10.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_E_term_10_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>No variation in this terms and conditions will be accepted.&#10;</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
            </subform>
            <subform layout="tb" name="g_terms_loc_fr" presence="hidden" w="19cm">
               <bind match="none"/>
               <event activity="initialize" name="initialize">
                  <script contentType="application/x-javascript">var p = this.parent;
                  function g(nm) { var f = p.resolveNode(nm); return (f &amp;&amp; f.rawValue) ? String(f.rawValue) : ""; }
                  var v = g("f_bsart"); var l = g("f_langu");
                  this.presence = (v !== "ZPOI" &amp;&amp; (v === "ZPOL" || v === "ZPOS" || l === "F")) ? "visible" : "hidden";</script>
               </event>
               <subform layout="position" minH="1.0cm" name="folder2_F_head" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw minH="1.0cm" name="folder2_F_head_t" w="19cm" x="0cm" y="0cm">
                     <value><text>&#10; Les autres termes et conditions applicables au bon de commande:&#10;</text></value>
                     <font size="8pt" typeface="Arial" weight="bold"/>
                     <para vAlign="middle"/>
                     <margin leftInset="0.25cm"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_1" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_1_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>1.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_1_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Prix exprimés sont basés sur un prix rendu au Congo.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_2" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_2_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>2.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_2_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Les Prix unitaires sont exclusivement sur la tax sur valeur ajoutée. (TVA)</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_3" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_3_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>3.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_3_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Le numéro de commande doit être inscrit sur toutes les factures afin d'effectuer le paiement.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_4" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_4_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>4.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_4_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Le terme de paiement, est strictement de 30 jours après la livraison, sauf accord contraire conformément à l'accord contractuel signé.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_5" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_5_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>5.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_5_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Guarantie: Lorsqu' une garantie est applicable, la documentation nécessaire doit accompagner les biens ou les services. Sinon, par défaut, les éléments couverts par ce bon  seront garanties pour 18 mois à compter de la date d'installation / mise en service.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_6" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_6_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>6.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_6_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Tous les autres certificats réglementaires à l'exemple de la Fiche de données de Sécurité (FDS), les Manuels d'Utilisation, de traitement des dechets etc., doivent être actuels et doivent accompagner ce bon de commande.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_7" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_7_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>7.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_7_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Les marchandises et / ou services ne seront acceptés que s'ils sont conformes à nos standards de  qualités et / ou à nos spécifications standar ds.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_8" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_8_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>8.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_8_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>La facture doit être établie sur la base de la plus faible quantité entre celle du pont bascule du fournisseur principal et celle du pont bascule de Dangote.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_9" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder2_F_term_9_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>9.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_9_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Toutes les factures doivent être envoyées au Département des finances.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder2_F_term_10" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/></border>
                  <draw h="0.5cm" name="folder2_F_term_10_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>10.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <draw minH="0.5cm" name="folder2_F_term_10_t" w="18.1cm" x="0.85cm" y="0cm">
                     <value><text>Aucune modification de ces termes et conditions ne sera acceptée.&#10;</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="top"/>
                  </draw>
               </subform>
            </subform>
            <subform layout="tb" name="g_close" w="19cm">
               <bind match="none"/>
               <subform h="0.45cm" layout="position" name="g_cl_blank1" w="19cm">
