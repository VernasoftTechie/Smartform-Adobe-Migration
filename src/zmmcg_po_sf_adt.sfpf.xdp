  if (lg eq "F") then $ = Concat($record.V_WAERS.value, " Total (Excl.TVA)") else $ = Concat($record.V_WAERS.value, " Total (Excl.VAT)") endif
endif
if (($record.V_BSART.value eq "ZPOI")) then
  if (lg eq "F") then $ = Concat($record.V_WAERS.value, " Total (Excl.TVA)") else $ = Concat($record.V_WAERS.value, " Total (Excl.VAT)") endif
endif
if (($record.V_BSART.value eq "ZPOL")) then
  if (lg eq "F") then $ = Concat($record.V_WAERS.value, " Total (Excl.VAT)") else $ = Concat($record.V_WAERS.value, " Total (Excl.TVA)") endif
