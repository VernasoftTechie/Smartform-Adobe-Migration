                  </draw>
               </subform>
               <subform layout="position" minH="0.5cm" name="folder4_F_term1" w="19cm">
                  <bind match="none"/>
                  <border><edge thickness="0.26mm"/><edge presence="hidden"/><edge thickness="0.26mm"/><edge presence="hidden"/></border>
                  <draw h="0.5cm" name="folder4_F_term1_n" w="0.55cm" x="0.25cm" y="0cm">
                     <value><text>1.</text></value>
                     <font size="8pt" typeface="Arial"/>
                     <para vAlign="middle"/>
                  </draw>
                  <field h="1mm" name="f_bsart" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.V_BSART"/></field>
                  <subform h="0.5cm" layout="position" name="folder4_F_term1_c" presence="hidden" w="18.1cm" x="0.85cm" y="0cm">
