         </subform>
         <subform layout="tb" name="service_tbl" presence="hidden" w="19cm">
            <bind match="none"/>
            <event activity="initialize" name="initialize">
               <script contentType="application/x-javascript">var f = this.parent.resolveNode("f_flag");
               var v = f ? f.rawValue : "";
               this.presence = (v === "Y") ? "visible" : "hidden";</script>
            </event>
            <subform h="0.9cm" id="s_head" layout="position" name="s_head" w="19cm">
               <occur max="-1"/>
               <bind match="none"/>
               <field h="1mm" name="f_bsart" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.V_BSART"/></field>
               <field h="1mm" name="f_langu" presence="hidden" w="1mm" x="0cm" y="0cm"><ui><textEdit/></ui><bind match="dataRef" ref="$.GV_LANGU"/></field>
               <draw h="0.9cm" name="s_h1" w="1.13cm" x="0cm" y="0cm">
                  <value><text>Sr No</text></value>
                  <font size="8pt" typeface="Arial" weight="bold"/>
                  <para hAlign="center" vAlign="middle"/>
                  <border><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><edge thickness="0.26mm"/><fill><color value="176,176,176"/></fill></border>
               </draw>
               <subform h="0.9cm" layout="position" name="s_h2_en" presence="hidden" w="3.14cm" x="1.13cm" y="0cm">
                  <bind match="none"/>
                  <event activity="initialize" name="initialize">
                     <script contentType="application/x-javascript">var f = this.parent.resolveNode("f_bsart");
                     var v = f ? f.rawValue : "";
                     var l = ""; try { var fl = this.parent.resolveNode("f_langu"); l = fl ? fl.rawValue : ""; } catch (e) { l = ""; }
                     this.presence = (!(v === "ZPOL" || v === "ZPOS" || l === "F")) ? "visible" : "hidden";</script>
                  </event>
                  <draw h="0.9cm" name="s_h2_en_t" w="3.14cm" x="0cm" y="0cm">
                     <value><text>Material No.</text></value>
