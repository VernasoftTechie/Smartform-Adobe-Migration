          <draw minH="0mm" name="C3" w="0.5mm"><ui><textEdit/></ui><value><text></text></value><font size="9pt" typeface="Arial"/><margin bottomInset="0mm" leftInset="0.7mm" rightInset="0mm" topInset="1.122mm"/><para hAlign="left" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/></border></draw>
          <field minH="4.2mm" name="C4" w="181mm"><ui><textEdit multiLine="1"><border presence="hidden"/><margin/></textEdit></ui><font size="9pt" typeface="Arial"/><margin bottomInset="0.51mm" leftInset="0.353mm" rightInset="0.8mm" topInset="0.3mm"/><para hAlign="left" lineHeight="3.39mm" textIndent="0.353mm" vAlign="top"/><border><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/><edge presence="hidden"/></border><calculate><script contentType="application/x-formcalc">var s = $record.V_BSART.value
var lg = "E"
if (s eq "ZPOL" or s eq "ZPOS" or (s ne "ZPOI" and $record.GV_LANGU.value eq "F")) then lg = "F" endif
$ = ""
if (($record.V_BSART.value ne "ZPOS")) then
  if (lg eq "F") then $ = "Les prix exprimés sont basés sur un prix de livraison au Cameroun." else $ = "Prices expressed are based on a delivered price in Cameroon." endif
endif
if (($record.V_BSART.value eq "ZPOS")) then
  $ = $record.GV_TERM1_ZPOS.value
endif</script></calculate><bind match="none"/></field>
