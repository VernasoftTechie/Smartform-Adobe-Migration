   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>GV_KSCHL</FPPARAMETER>
      <FPPARAMETER>LS_MKPF</FPPARAMETER>
      <FPPARAMETER>LV_NAME</FPPARAMETER>
      <FPPARAMETER>LS_MSEG</FPPARAMETER>
     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>GV_KSCHL</FPPARAMETER>
      <FPPARAMETER>LV_NAME</FPPARAMETER>
      <FPPARAMETER>LV_BUTXT</FPPARAMETER>
      <FPPARAMETER>MONTH</FPPARAMETER>
      <FPPARAMETER>DATE</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>IMPORT p1 TO gv_kschl FROM MEMORY ID &apos;YSN_YM07DRAUS&apos;.</FPCLINE>
      <FPCLINE>FREE MEMORY ID &apos;YSN_YM07DRAUS&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>IF gv_kschl = &apos;WE01&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  DATA: lv_pers_no TYPE ad_persnum.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  CLEAR lv_name.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  SELECT SINGLE persnumber</FPCLINE>
      <FPCLINE>    FROM usr21</FPCLINE>
      <FPCLINE>    INTO lv_pers_no</FPCLINE>
      <FPCLINE>    WHERE bname = ls_mkpf-usnam.</FPCLINE>
      <FPCLINE>  IF sy-subrc = 0.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    SELECT SINGLE name_text</FPCLINE>
      <FPCLINE>      FROM adrp</FPCLINE>
      <FPCLINE>      INTO lv_name</FPCLINE>
      <FPCLINE>      WHERE persnumber = lv_pers_no.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>select single  butxt from t001 into lv_butxt where bukrs = ls_mseg-bukrs.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CALL FUNCTION &apos;ZABF_ISP_GET_MONTH_NAME&apos;</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>   DATE               = ls_mkpf-bldat</FPCLINE>
      <FPCLINE>    LANGUAGE           = SY-LANGU</FPCLINE>
      <FPCLINE> IMPORTING</FPCLINE>
      <FPCLINE>   SHORTTEXT          = MONTH</FPCLINE>
      <FPCLINE> EXCEPTIONS</FPCLINE>
      <FPCLINE>   CALENDAR_ID        = 1</FPCLINE>
      <FPCLINE>   DATE_ERROR         = 2</FPCLINE>
      <FPCLINE>   NOT_FOUND          = 3</FPCLINE>
      <FPCLINE>   WRONG_INPUT        = 4</FPCLINE>
      <FPCLINE>   OTHERS             = 5</FPCLINE>
      <FPCLINE>          .</FPCLINE>
      <FPCLINE>IF SY-SUBRC &lt;&gt; 0.</FPCLINE>
      <FPCLINE>* Implement suitable error handling here</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>CONCATENATE ls_mkpf-bldat+6(2) &apos;-&apos; month &apos;-&apos; ls_mkpf-bldat+0(4)</FPCLINE>
      <FPCLINE>   into date.</FPCLINE>
     </INITIALIZATION>
     <FORMS/>
    </CL_FP_CODING>
   </cls:CL_FP_CODING>
