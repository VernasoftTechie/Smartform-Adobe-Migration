     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>LV_AMNT</FPPARAMETER>
      <FPPARAMETER>LS_FLEXA</FPPARAMETER>
      <FPPARAMETER>IS_BSAK</FPPARAMETER>
      <FPPARAMETER>LV_DEBIT</FPPARAMETER>
      <FPPARAMETER>LV_CREDIT</FPPARAMETER>
      <FPPARAMETER>GT_FLEXA_ROWS</FPPARAMETER>
      <FPPARAMETER>GT_BSAK_ROWS</FPPARAMETER>
      <FPPARAMETER>GV_ZALDT</FPPARAMETER>
      <FPPARAMETER>GV_LIFNR</FPPARAMETER>
      <FPPARAMETER>GV_VBLNR</FPPARAMETER>
      <FPPARAMETER>GV_CHECT</FPPARAMETER>
      <FPPARAMETER>GV_AMNT</FPPARAMETER>
      <FPPARAMETER>GV_BANKN</FPPARAMETER>
      <FPPARAMETER>GV_BANK_TEXT</FPPARAMETER>
      <FPPARAMETER>GV_WAERS</FPPARAMETER>
      <FPPARAMETER>GV_WORDS</FPPARAMETER>
      <FPPARAMETER>GV_VENDOR_NAME</FPPARAMETER>
      <FPPARAMETER>GV_XBLNR</FPPARAMETER>
      <FPPARAMETER>GV_INV_DOC</FPPARAMETER>
      <FPPARAMETER>GV_INT_NUMBER</FPPARAMETER>
      <FPPARAMETER>GV_PREPARER</FPPARAMETER>
      <FPPARAMETER>GV_COMP_NAME</FPPARAMETER>
      <FPPARAMETER>GV_COMP_LINE1</FPPARAMETER>
      <FPPARAMETER>GV_COMP_LINE2</FPPARAMETER>
      <FPPARAMETER>GV_COMP_LINE3</FPPARAMETER>
      <FPPARAMETER>GV_TOTAL_TXT</FPPARAMETER>
      <FPPARAMETER>GV_DEBIT_TXT</FPPARAMETER>
      <FPPARAMETER>GV_CREDIT_TXT</FPPARAMETER>
      <FPPARAMETER>GV_REPRINT_TXT</FPPARAMETER>
      <FPPARAMETER>GV_SIGN1_TITLE</FPPARAMETER>
      <FPPARAMETER>GV_SIGN2_TITLE</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>IF IS_PAYR-RWBTR &lt; 0.</FPCLINE>
      <FPCLINE>LV_AMNT = IS_PAYR-RWBTR * -1.</FPCLINE>
      <FPCLINE>else.</FPCLINE>
      <FPCLINE>  LV_AMNT = IS_PAYR-RWBTR.</FPCLINE>
      <FPCLINE>ENDIF.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-6): main window %WINDOW6, table %TABLE2 over IT_FLEXA =====================</FPCLINE>
      <FPCLINE>" %CODE1 ran once per row in the Smart Form. An Adobe table cannot run code, so it runs here,</FPCLINE>
      <FPCLINE>" verbatim, in a LOOP, and GT_FLEXA_ROWS keeps what the row printed (debit / credit by DRCRK).</FPCLINE>
      <FPCLINE>DATA lv_bolt_out TYPE c LENGTH 255.</FPCLINE>
      <FPCLINE>LOOP AT it_flexa INTO ls_flexa.</FPCLINE>
      <FPCLINE>* --- %CODE1 New Program Lines 1 (verbatim)</FPCLINE>
      <FPCLINE>  IF ls_flexa-tsl &lt; &apos;0.00&apos;.</FPCLINE>
      <FPCLINE>  multiply ls_flexa-tsl by -1.</FPCLINE>
      <FPCLINE>  add ls_flexa-tsl to lv_credit.</FPCLINE>
      <FPCLINE>  else.</FPCLINE>
      <FPCLINE>    add ls_flexa-tsl to lv_debit.</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  " BOLT: the cells of %ROW5 as printed</FPCLINE>
      <FPCLINE>  APPEND INITIAL LINE TO gt_flexa_rows ASSIGNING FIELD-SYMBOL(&lt;lfs_flexa&gt;).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-budat TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-budat = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-logsys TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-logsys = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  " Description = &amp;RFAREA&amp;&amp;SCNTR&amp;&amp;PPRCTR&amp;&amp;SFAREA&amp; (no separators, as in the Smart Form)</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-rfarea TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-descr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-scntr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-descr = &lt;lfs_flexa&gt;-descr &amp;&amp; condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-pprctr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-descr = &lt;lfs_flexa&gt;-descr &amp;&amp; condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-sfarea TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-descr = &lt;lfs_flexa&gt;-descr &amp;&amp; condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-rcntr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-rcntr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  WRITE ls_flexa-prctr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_flexa&gt;-prctr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  IF ls_flexa-drcrk = &apos;S&apos;.</FPCLINE>
      <FPCLINE>    WRITE ls_flexa-tsl TO lv_bolt_out CURRENCY ls_flexa-rtcur.</FPCLINE>
      <FPCLINE>    &lt;lfs_flexa&gt;-debit = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>  IF ls_flexa-drcrk = &apos;H&apos;.</FPCLINE>
      <FPCLINE>    WRITE ls_flexa-tsl TO lv_bolt_out CURRENCY ls_flexa-rtcur.</FPCLINE>
      <FPCLINE>    &lt;lfs_flexa&gt;-credit = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>  ENDIF.</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE>WRITE lv_debit TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_debit_txt = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE lv_credit TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_credit_txt = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-6): window MAIN, table %TABLE1 over IT_BSAK (no program lines) ============</FPCLINE>
      <FPCLINE>LOOP AT it_bsak INTO is_bsak.</FPCLINE>
      <FPCLINE>  APPEND INITIAL LINE TO gt_bsak_rows ASSIGNING FIELD-SYMBOL(&lt;lfs_bsak&gt;).</FPCLINE>
      <FPCLINE>  &lt;lfs_bsak&gt;-sgtxt1 = iv_sgtxt1.</FPCLINE>
      <FPCLINE>  &lt;lfs_bsak&gt;-sgtxt  = is_bsak-sgtxt.</FPCLINE>
      <FPCLINE>  " WRBTR: the form declares no reference field for it (REFFIELDS: only LS_FLEXA-TSL) - plain WRITE</FPCLINE>
      <FPCLINE>  WRITE is_bsak-wrbtr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>  &lt;lfs_bsak&gt;-wrbtr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>ENDLOOP.</FPCLINE>
      <FPCLINE>" GV_TOTAL is never filled by the legacy form (prints 0.00) - kept as it is (version 1 = legacy).</FPCLINE>
      <FPCLINE>WRITE gv_total TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_total_txt = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>" ===== BOLT (Window-6): the other printed values, as the Smart Form printed them ==============</FPCLINE>
      <FPCLINE>WRITE is_payr-zaldt TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_zaldt = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE is_payr-lifnr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_lifnr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE is_payr-vblnr TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_vblnr = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE is_payr-chect TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_chect = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE lv_amnt TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_amnt = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>WRITE is_t012k-bankn TO lv_bolt_out.</FPCLINE>
      <FPCLINE>gv_bankn = condense( lv_bolt_out ).</FPCLINE>
      <FPCLINE>gv_bank_text   = is_t012t-text1.</FPCLINE>
      <FPCLINE>gv_waers       = is_payr-waers.</FPCLINE>
      <FPCLINE>gv_words       = iv_spell-word.</FPCLINE>
      <FPCLINE>gv_vendor_name = is_lfa1-name1.</FPCLINE>
