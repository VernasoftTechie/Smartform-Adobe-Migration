    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>IS_PAYR</FPPARAMETER>
      <FPPARAMETER>IT_FLEXA</FPPARAMETER>
      <FPPARAMETER>IT_BSAK</FPPARAMETER>
