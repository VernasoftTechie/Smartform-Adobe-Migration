"    1)Taxes Payable(" + g("r_waers") + "):" + g("t_lv_kwert"),
"    2)Discount Applicable(" + g("r_waers") + "):" + g("t_v_kwert"),
"    3)Freight Applicable(" + g("r_waers") + "):" + g("t_v2_kwert"),
