zpp007-flap_width_tolerance,</FPCLINE><FPCLINE>        wind_up_station         TYPE zpp007-stperforation,</FPCLINE><FPCLINE>      END OF ty_final,</FPCLINE><FPCLINE>      ""eoc by surbhi sugg by ranga on 14.10.2024</FPCLINE><FPCLINE>      tt_final type standard table of ty_final.</FPCLINE></TYPES><FIELDSYMBOLS/></CL_FP_GLOBAL_DEFINITIONS></cls:CL_FP_GLOBAL_DEFINITIONS><cls:CL_FP_PARAMETERS id="o542"><CL_FP_INTERFACE_DATA_CHANGED classVersion="1"><INTERFACE_DATA href="#o543"/></CL_FP_INTERFACE_DATA_CHANGED><CL_FP_PARAMETERS classVersion="1"><IMPORT_PARAMETERS><SFPIOPAR><NAME>WERKS</NAME><TYPING>TYPE</TYPING><TYPENAME>WERKS_D</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>MATKL</NAME><TYPING>TYPE</TYPING><TYPENAME>MATKL</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>ZFORMAT</NAME><TYPING>TYPE</TYPING><TYPENAME>ZFORMAT</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>DOCUMENT</NAME><TYPING>TYPE</TYPING><TYPENAME>ZDOCNO</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>REVISION</NAME><TYPING>TYPE</TYPING><TYPENAME>ZREVI</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>CHANGE</NAME><TYPING>TYPE</TYPING><TYPENAME>ZCHANGE</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>CLASSIFICATION</NAME><TYPING>TYPE</TYPING><TYPENAME>ZCLASSIFICATE</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR><SFPIOPAR><NAME>OTHER</NAME><TYPING>TYPE</TYPING><TYPENAME>ZOTHER</TYPENAME><OPTIONAL/><BYVALUE/><DEFAULTVAL/><STANDARD/><CONSTANT/></SFPIOPAR></IMPORT_PARAMETERS><EXPORT_PARAMETERS/><TABLE_PARAMETERS/><EXCEPTIONS/></CL_FP_PARAMETERS></cls:CL_FP_PARAMETERS><cls:CL_FP_CODING id="o530"><CL_FP_INTERFACE_DATA_CHANGED classVersion="1"><INTERFACE_DATA href="#o543"/></CL_FP_INTERFACE_DATA_CHANGED><CL_FP_CODING classVersion="1"><INPUT_PARAMETERS><FPPARAMETER>MATKL</FPPARAMETER><FPPARAMETER>CLASSIFICATION</FPPARAMETER><FPPARAMETER>WERKS</FPPARAMETER></INPUT_PARAMETERS><OUTPUT_PARAMETERS/><INITIALIZATION><FPCLINE>TYPES: BEGIN OF ty_matnr,</FPCLINE><FPCLINE>         matnr TYPE matnr,</FPCLINE><FPCLINE>         werks TYPE werks_d,</FPCLINE><FPCLINE>       END OF ty_matnr.</FPCLINE><FPCLINE>DATA: seltab    TYPE TABLE OF rsparams,</FPCLINE><FPCLINE>      seltab_wa LIKE LINE OF seltab,</FPCLINE><FPCLINE>      lt_matnr  TYPE STANDARD TABLE OF ty_matnr.</FPCLINE><FPCLINE/><FPCLINE>DATA : gs_data TYPE REF TO data.</FPCLINE><FPCLINE>FIELD-SYMBOLS : &lt;gt_data&gt; TYPE STANDARD TABLE,</FPCLINE><FPCLINE>                &lt;g_data&gt;  TYPE any,</FPCLINE><FPCLINE>                &lt;fs_open&gt; TYPE any.</FPCLINE><FPCLINE/><FPCLINE/><FPCLINE>lv_date = |{ sy-datum DATE = USER }|.</FPCLINE><FPCLINE/><FPCLINE>"List of material tyres group code.</FPCLINE><FPCLINE>SELECT sign,opti AS option,low,high FROM tvarvc</FPCLINE><FPCLINE>  WHERE opti = 'EQ'</FPCLINE><FPCLINE>    AND sign = 'I'</FPCLINE><FPCLINE>    AND name = 'ZPP_GREEN_TYRE_GRP'</FPCLINE><FPCLINE>  INTO TABLE @DATA(lt_tvarvc).</FPCLINE><FPCLINE/><FPCLINE>"""BOc by surbhi sugg by ranga on 11.10.2024</FPCLINE><FPCLINE/><FPCLINE>SELECT matnr, matkl FROM mara</FPCLINE><FPCLINE>INTO TABLE @DATA(lt_mara)</FPCLINE><FPCLINE>WHERE matkl = @matkl.</FPCLINE><FPCLINE>IF sy-subrc = 0.</FPCLINE><FPCLINE/><FPCLINE>  SELECT werks, matnr FROM marc</FPCLINE><FPCLINE>  INTO TABLE @DATA(lt_marc)</FPCLINE><FPCLINE>       FOR ALL ENTRIES IN @lt_mara</FPCLINE><FPCLINE>       WHERE matnr = @lt_mara-matnr</FPCLINE><FPCLINE>       AND werks = @werks.</FPCLINE><FPCLINE>  IF sy-subrc = 0.</FPCLINE><FPCLINE/><FPCLINE>    SELECT werks, matnr, aennr , stlal, stlan, endda FROM zpp007</FPCLINE><FPCLINE>      INTO TABLE @DATA(lt_zpp007)</FPCLINE><FPCLINE>      FOR ALL ENTRIES IN @lt_marc</FPCLINE><FPCLINE>      WHERE werks = @lt_marc-werks</FPCLINE><FPCLINE>      AND   matnr = @lt_marc-matnr</FPCLINE><FPCLINE>      AND   stlal = '01'</FPCLINE><FPCLINE>      AND   stlan = '1'</FPCLINE><FPCLINE>      AND   endda = '99991231'.</FPCLINE><FPCLINE>    IF sy-subrc = 0.</FPCLINE><FPCLINE/><FPCLINE>      SELECT werks, matnr, aennr, stlal, stlan, idnrk, dropd FROM zpp006</FPCLINE><FPCLINE>        INTO TABLE @DATA(lt_zpp006)</FPCLINE><FPCLINE>        FOR ALL ENTRIES IN @lt_zpp007</FPCLINE><FPCLINE>        WHERE werks = @lt_zpp007-werks</FPCLINE><FPCLINE>        AND   matnr = @lt_zpp007-matnr</FPCLINE><FPCLINE>        AND   aennr = @lt_zpp007-aennr</FPCLINE><FPCLINE>        AND   stlal = '01'</FPCLINE><FPCLINE>        AND   stlan = '1'</FPCLINE><FPCLINE>*        AND   dropd IN ('9', '11', '12', '14', '15', '16').      "334287 Vishnu 26.05.2025 sugg by mandeep</FPCLINE><FPCLINE>        AND   dropd IN ('8', '9', '11', '12', '13', '14', '15', '16'). "334287 Vishnu 26.05.2025 sugg by mandeep</FPCLINE><FPCLINE>      IF sy-subrc = 0.</FPCLINE><FPCLINE>        SORT lt_zpp006 BY werks matnr.</FPCLINE><FPCLINE>* Begin of change 334287 Vishnu 23.05.2025 sugg by mandeep ---&gt;</FPCLINE><FPCLINE/><FPCLINE>        SELECT werks, matnr, aennr, stlal, stlan, classification</FPCLINE><FPCLINE>               FROM zpp007_v1 INTO TABLE @DATA(lt_zpp007_v1)</FPCLINE><FPCLINE>               FOR ALL ENTRIES IN @lt_zpp006</FPCLINE><FPCLINE>               WHERE werks = @lt_zpp006-werks</FPCLINE><FPCLINE>                AND  matnr = @lt_zpp006-idnrk</FPCLINE><FPCLINE>           AND  stlal = '01'</FPCLINE><FPCLINE>           AND  stlan = '1'</FPCLINE><FPCLINE>           AND  endda = '99991231'.</FPCLINE><FPCLINE>        IF sy-subrc EQ 0.</FPCLINE><FPCLINE>          SORT lt_zpp007_v1 BY werks matnr.</FPCLINE><FPCLINE>        ENDIF.</FPCLINE><FPCLINE>* Change of change 334287 Vishnu 23.05.2025 sugg by mandeep &lt;---</FPCLINE><FPCLINE/><FPCLINE>        SELECT werks, matnr, aennr, stlal, stlan, endda, stperforation,</FPCLINE><FPCLINE>          scutwidth, scutangle, width_tolerance, flap_width_tolerance FROM zpp007</FPCLINE><FPCLINE>          INTO TABLE @DATA(lt_zpp007_fab)</FPCLINE><FPCLINE>          FOR ALL ENTRIES IN @lt_zpp006</FPCLINE><FPCLINE>          WHERE werks = @lt_zpp006-werks</FPCLINE><FPCLINE>           AND  matnr = @lt_zpp006-idnrk</FPCLINE><FPCLINE>           AND  stlal = '01'</FPCLINE><FPCLINE>           AND  stlan = '1'</FPCLINE><FPCLINE>           AND  endda = '99991231'.</FPCLINE><FPCLINE>        IF sy-subrc = 0.</FPCLINE><FPCLINE/><FPCLINE>          SELECT werks, matnr, aennr, stlal, stlan, idnrk FROM zpp006</FPCLINE><FPCLINE>            INTO TABLE @DATA(lt_zpp006_fab)</FPCLINE><FPCLINE>            FOR ALL ENTRIES IN @lt_zpp007_fab</FPCLINE><FPCLINE>            WHERE werks = @lt_zpp007_fab-werks</FPCLINE><FPCLINE>            AND   matnr = @lt_zpp007_fab-matnr</FPCLINE><FPCLINE>            AND   aennr = @lt_zpp007_fab-aennr</FPCLINE><FPCLINE>            AND   stlal = '01'</FPCLINE><FPCLINE>            AND   stlan = '1'.</FPCLINE><FPCLINE>          IF sy-subrc = 0.</FPCLINE><FPCLINE>            SORT lt_zpp006_fab BY werks matnr.</FPCLINE><FPCLINE/><FPCLINE>            SELECT werks, matnr, aennr, stlal, stlan, endda FROM zpp007</FPCLINE><FPCLINE>            INTO TABLE @DATA(lt_zpp007_dip)</FPCLINE><FPCLINE>            FOR ALL ENTRIES IN @lt_zpp006_fab</FPCLINE><FPCLINE>            WHERE werks = @lt_zpp006_fab-werks</FPCLINE><FPCLINE>             AND  matnr = @lt_zpp006_fab-idnrk</FPCLINE><FPCLINE>             AND  stlal = '01'</FPCLINE><FPCLINE>             AND  stlan = '1'</FPCLINE><FPCLINE>             AND  endda = '99991231'.</FPCLINE><FPCLINE>            IF sy-subrc = 0.</FPCLINE><FPCLINE/><FPCLINE>              SELECT werks, matnr, aennr, stlal, stlan, idnrk FROM zpp006</FPCLINE><FPCLINE>                INTO TABLE @DATA(lt_zpp006_dip)</FPCLINE><FPCLINE>                FOR ALL ENTRIES IN @lt_zpp007_dip</FPCLINE><FPCLINE>                WHERE werks = @lt_zpp007_dip-werks</FPCLINE><FPCLINE>                AND   matnr = @lt_zpp007_dip-matnr</FPCLINE><FPCLINE>                AND   aennr = @lt_zpp007_dip-aennr</FPCLINE><FPCLINE>                AND   stlal = '01'</FPCLINE><FPCLINE>                AND   stlan = '1'.</FPCLINE><FPCLINE>              IF sy-subrc = 0.</FPCLINE><FPCLINE>                SORT lt_zpp006_dip BY werks matnr.</FPCLINE><FPCLINE>              ENDIF.</FPCLINE><FPCLINE>            ENDIF.</FPCLINE><FPCLINE>          ENDIF.</FPCLINE><FPCLINE>        ENDIF.</FPCLINE><FPCLINE>**  Begin of change Vishnu 27.05.2025 sugg by Mandeep ----&gt;</FPCLINE><FPCLINE>        SELECT werks, matnr, aennr, width, stangl, scutwidth FROM zpp007</FPCLINE><FPCLINE>              INTO TABLE @DATA(lt_007s)</FPCLINE><FPCLINE>              FOR ALL ENTRIES IN @lt_zpp006</FPCLINE><FPCLINE>              WHERE werks = @lt_zpp006-werks</FPCLINE><FPCLINE>                AND matnr = @lt_zpp006-idnrk</FPCLINE><FPCLINE>                AND stlal = '01'</FPCLINE><FPCLINE>                AND stlan = '1'</FPCLINE><FPCLINE>                AND endda = '99991231'.</FPCLINE><FPCLINE>        IF sy-subrc EQ 0.</FPCLINE><FPCLINE>          SELECT werks, matnr, aennr, idnrk, dropd, width, fweight, length, norounds, scrmark</FPCLINE><FPCLINE>              FROM zpp006 INTO TABLE @DATA(lt_006s)</FPCLINE><FPCLINE>                     FOR ALL ENTRIES IN @lt_007s</FPCLINE><FPCLINE>                     WHERE werks = @lt_007s-werks</FPCLINE><FPCLINE>                       AND matnr = @lt_007s-matnr</FPCLINE><FPCLINE>                       AND aennr = @lt_007s-aennr</FPCLINE><FPCLINE>                       AND dropd IN ( '3', '03' ).</FPCLINE><FPCLINE>          IF sy-subrc EQ 0.</FPCLINE><FPCLINE>            SORT lt_006s BY werks matnr aennr.</FPCLINE><FPCLINE>            SELECT werks, matnr, aennr, stlal, stlan, classification</FPCLINE><FPCLINE>                   FROM zpp007_v1 INTO TABLE @DATA(lt_007_v1)</FPCLINE><FPCLINE>                   FOR ALL ENTRIES IN @lt_006s</FPCLINE><FPCLINE>                   WHERE werks = @lt_006s-werks</FPCLINE><FPCLINE>                    AND  matnr = @lt_006s-idnrk</FPCLINE><FPCLINE>                    AND  stlal = '01'</FPCLINE><FPCLINE>                    AND  stlan = '1'</FPCLINE><FPCLINE>                    AND  endda = '99991231'.</FPCLINE><FPCLINE>            IF sy-subrc EQ 0.</FPCLINE><FPCLINE>              SORT lt_007_v1 BY werks matnr.</FPCLINE><FPCLINE>            ENDIF.</FPCLINE><FPCLINE/><FPCLINE>            SELECT werks, matnr, aennr, width, stangl, scutwidth, width_tolerance, flap_width_tolerance FROM zpp007</FPCLINE><FPCLINE>                       INTO TABLE @DATA(lt_007)</FPCLINE><FPCLINE>                       FOR ALL ENTRIES IN @lt_006s</FPCLINE><FPCLINE>                       WHERE werks = @lt_006s-werks</FPCLINE><FPCLINE>                         AND matnr = @lt_006s-idnrk</FPCLINE><FPCLINE>                         AND stlal = '01'</FPCLINE><FPCLINE>                         AND stlan = '1'</FPCLINE><FPCLINE>                         AND endda = '99991231'.</FPCLINE><FPCLINE>            IF sy-subrc EQ 0.</FPCLINE><FPCLINE>              SORT lt_007 BY aennr DESCENDING.</FPCLINE><FPCLINE>              SELECT werks, matnr, aennr, idnrk, dropd, width, fweight, length, norounds, scrmark</FPCLINE><FPCLINE>                  FROM zpp006 INTO TABLE @DATA(lt_006)</FPCLINE><FPCLINE>                         FOR ALL ENTRIES IN @lt_007</FPCLINE><FPCLINE>                         WHERE werks = @lt_007-werks</FPCLINE><FPCLINE>                           AND matnr = @lt_007-matnr</FPCLINE><FPCLINE>                           AND aennr = @lt_007-aennr.</FPCLINE><FPCLINE>              IF sy-subrc EQ 0.</FPCLINE><FPCLINE>                SORT lt_006 BY werks matnr aennr.</FPCLINE><FPCLINE/><FPCLINE>                SELECT werks, matnr, aennr, width, stangl, scutwidth FROM zpp007</FPCLINE><FPCLINE>                                         INTO TABLE @DATA(lt_007l)</FPCLINE><FPCLINE>                                         FOR ALL ENTRIES IN @lt_006</FPCLINE><FPCLINE>                                         WHERE werks = @lt_006-werks</FPCLINE><FPCLINE>                                           AND matnr = @lt_006-idnrk</FPCLINE><FPCLINE>                                           AND stlal = '01'</FPCLINE><FPCLINE>                                           AND stlan = '1'</FPCLINE><FPCLINE>                                           AND endda = '99991231'.</FPCLINE><FPCLINE>                IF sy-subrc EQ 0.</FPCLINE><FPCLINE>                  SORT lt_007l BY aennr DESCENDING.</FPCLINE><FPCLINE>                  SELECT werks, matnr, aennr, idnrk, dropd, width, fweight, length, norounds, scrmark</FPCLINE><FPCLINE>                      FROM zpp006 INTO TABLE @DATA(lt_006l)</FPCLINE><FPCLINE>                             FOR ALL ENTRIES IN @lt_007l</FPCLINE><FPCLINE>                             WHERE werks = @lt_007l-werks</FPCLINE><FPCLINE>                               AND matnr = @lt_007l-matnr</FPCLINE><FPCLINE>                               AND aennr = @lt_007l-aennr.</FPCLINE><FPCLINE>                  IF sy-subrc EQ 0.</FPCLINE><FPCLINE>                    SORT lt_006l BY werks matnr aennr dropd.</FPCLINE><FPCLINE>                  ENDIF.</FPCLINE><FPCLINE>                ENDIF.</FPCLINE><FPCLINE/><FPCLINE>              ENDIF.</FPCLINE><FPCLINE/><FPCLINE>            ENDIF.</FPCLINE><FPCLINE>          ENDIF.</FPCLINE><FPCLINE>        ENDIF.</FPCLINE><FPCLINE>*****  End of change Vishnu 27.05.2025 sugg by Mandeep &lt;----</FPCLINE><FPCLINE/><FPCLINE>      ENDIF.</FPCLINE><FPCLINE>    ENDIF.</FPCLINE><FPCLINE>  ENDIF.</FPCLINE><FPCLINE>ENDIF.</FPCLINE><FPCLINE/><FPCLINE>DELETE ADJACENT DUPLICATES FROM lt_zpp006 COMPARING ALL FIELDS.</FPCLINE><FPCLINE>LOOP AT lt_marc INTO DATA(ls_marc).</FPCLINE><FPCLINE/><FPCLINE>  ls_final-size = ls_marc-matnr.</FPCLINE><FPCLINE/><FPCLINE>  READ TABLE lt_zpp007 INTO DATA(lw_zpp007) WITH KEY werks = ls_marc-werks</FPCLINE><FPCLINE>                                                     