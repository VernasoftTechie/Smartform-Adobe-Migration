NG</FPCLINE><FPCLINE>      iv_formname = lc_from_name    " PDF-Based Forms: Form Name</FPCLINE><FPCLINE>      iv_language = sy-langu    " Language Key</FPCLINE><FPCLINE>    IMPORTING</FPCLINE><FPCLINE>      it_labels   = DATA(lt_labels)  " Table Type for Adobe form labels</FPCLINE><FPCLINE>  ).</FPCLINE><FPCLINE/><FPCLINE>  "Assign Labels dynamically</FPCLINE><FPCLINE>  DATA:lo_stru TYPE REF TO cl_abap_structdescr.</FPCLINE><FPCLINE/><FPCLINE>  lo_stru ?= cl_abap_typedescr=&gt;describe_by_data( gs_labels ).</FPCLINE><FPCLINE/><FPCLINE>  IF lo_stru IS BOUND.</FPCLINE><FPCLINE>    DATA(lt_components) = lo_stru-&gt;get_components( ).</FPCLINE><FPCLINE>    IF lt_components IS NOT INITIAL.</FPCLINE><FPCLINE>      LOOP AT lt_components ASSIGNING FIELD-SYMBOL(&lt;lfs_components&gt;).</FPCLINE><FPCLINE>        DATA(lv_fields_name) = VALUE zde_label_id( ).</FPCLINE><FPCLINE>        lv_fields_name = &lt;lfs_components&gt;-name.</FPCLINE><FPCLINE>        READ TABLE lt_labels ASSIGNING FIELD-SYMBOL(&lt;lfs_labels&gt;)</FPCLINE><FPCLINE>        WITH KEY label_id = lv_fields_name.</FPCLINE><FPCLINE>        IF sy-subrc = 0.</FPCLINE><FPCLINE>          ASSIGN COMPONENT lv_fields_name OF STRUCTURE gs_labels TO FIELD-SYMBOL(&lt;lfs_value&gt;).</FPCLINE><FPCLINE>          IF &lt;lfs_value&gt; IS ASSIGNED AND sy-subrc IS INITIAL.</FPCLINE><FPCLINE>            &lt;lfs_value&gt; = &lt;lfs_labels&gt;-translated_label.</FPCLINE><FPCLINE>          ENDIF.</FPCLINE><FPCLINE>        ENDIF.</FPCLINE><FPCLINE>      ENDLOOP.</FPCLINE><FPCLINE>    ENDIF.</FPCLINE><FPCLINE/><FPCLINE>    gs_labels-lb_part_no = gs_labels-lb_part_no &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>   &amp;&amp; gs_labels-lb_cust_part_no &amp;&amp; cl_abap_char_utilities=&gt;newline &amp;&amp; 'PO No.(商品编号)'.</FPCLINE><FPCLINE>    gs_labels-lb_bnk_out_tax = |{ gs_labels-lb_bnk_out_tax }{ gs_header-output_tax_rate }|.</FPCLINE><FPCLINE/><FPCLINE>    gs_labels-lb_item_no = gs_labels-lb_item_no &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                         &amp;&amp; '(商品编号)'.</FPCLINE><FPCLINE>    gs_labels-lb_itm_desc = gs_labels-lb_itm_desc &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                          &amp;&amp; '(描述)'.</FPCLINE><FPCLINE>    gs_labels-lb_itm_price = gs_labels-lb_itm_price &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                             &amp;&amp; '(价格)'.</FPCLINE><FPCLINE>    gs_labels-lb_itm_ut_price = gs_labels-lb_itm_ut_price &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                              &amp;&amp; '(单价单位)'.</FPCLINE><FPCLINE>    gs_labels-lb_itm_qty = gs_labels-lb_itm_qty &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                           &amp;&amp; '(数量)'.</FPCLINE><FPCLINE>    gs_labels-lb_itm_amt = gs_labels-lb_itm_amt &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>                           &amp;&amp; '(应付金额)'.</FPCLINE><FPCLINE>    gs_labels-lb_e_o_e = |{ gs_labels-lb_e_o_e } { gs_header-e_o_e }|.</FPCLINE><FPCLINE>  ENDIF.</FPCLINE><FPCLINE/><FPCLINE>ELSEIF gs_header-kschl = 'ZSEA'.</FPCLINE><FPCLINE/><FPCLINE>  CLEAR :lt_labels,lt_components,lv_fields_name.</FPCLINE><FPCLINE>  "Fetch Labels form Adobe Form Labels Table</FPCLINE><FPCLINE>  zcl_adobeform_utility=&gt;get_header_labels(</FPCLINE><FPCLINE>    EXPORTING</FPCLINE><FPCLINE>      iv_formname = lc_from_name    " PDF-Based Forms: Form Name</FPCLINE><FPCLINE>      iv_language = sy-langu    " Language Key</FPCLINE><FPCLINE>    IMPORTING</FPCLINE><FPCLINE>      it_labels   = lt_labels  " Table Type for Adobe form labels</FPCLINE><FPCLINE>  ).</FPCLINE><FPCLINE/><FPCLINE>  lo_stru ?= cl_abap_typedescr=&gt;describe_by_data( gs_labels ).</FPCLINE><FPCLINE/><FPCLINE>  IF lo_stru IS BOUND.</FPCLINE><FPCLINE>    lt_components = lo_stru-&gt;get_components( ).</FPCLINE><FPCLINE>    IF lt_components IS NOT INITIAL.</FPCLINE><FPCLINE>      LOOP AT lt_components ASSIGNING &lt;lfs_components&gt;.</FPCLINE><FPCLINE>        lv_fields_name = VALUE zde_label_id( ).</FPCLINE><FPCLINE>        lv_fields_name = &lt;lfs_components&gt;-name.</FPCLINE><FPCLINE>        READ TABLE lt_labels ASSIGNING &lt;lfs_labels&gt;</FPCLINE><FPCLINE>        WITH KEY label_id = lv_fields_name.</FPCLINE><FPCLINE>        IF sy-subrc = 0.</FPCLINE><FPCLINE>          ASSIGN COMPONENT lv_fields_name OF STRUCTURE gs_labels TO FIELD-SYMBOL(&lt;lfs_value1&gt;).</FPCLINE><FPCLINE>          IF &lt;lfs_value1&gt; IS ASSIGNED AND sy-subrc IS INITIAL.</FPCLINE><FPCLINE>            &lt;lfs_value1&gt; = &lt;lfs_labels&gt;-label_text.</FPCLINE><FPCLINE>          ENDIF.</FPCLINE><FPCLINE>        ENDIF.</FPCLINE><FPCLINE>      ENDLOOP.</FPCLINE><FPCLINE>    ENDIF.</FPCLINE><FPCLINE>**bill_dt</FPCLINE><FPCLINE> gs_labels-lb_bill_dt = gs_labels-lb_bill_dt &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>**del_note</FPCLINE><FPCLINE> gs_labels-lb_del_note = gs_labels-lb_del_note &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>** pay_terms</FPCLINE><FPCLINE> gs_labels-lb_pay_terms = gs_labels-lb_pay_terms &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>** doc_cur</FPCLINE><FPCLINE> gs_labels-lb_doc_cur = gs_labels-lb_doc_cur &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>** del_terms</FPCLINE><FPCLINE> gs_labels-lb_del_terms = gs_labels-lb_del_terms &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>*** uuid</FPCLINE><FPCLINE>    gs_labels-lb_uuid = gs_labels-lb_uuid &amp;&amp; space &amp;&amp; ':'.</FPCLINE><FPCLINE>    DATA(gv_cust_po_no) = |{ gs_labels-lb_cust_part_no }  { 'PO No.' }|.</FPCLINE><FPCLINE>    gs_labels-lb_part_no = gs_labels-lb_part_no &amp;&amp; cl_abap_char_utilities=&gt;newline</FPCLINE><FPCLINE>         &amp;&amp; gv_cust_po_no .</FPCLINE><FPCLINE>*         &amp;&amp; gs_labels-lb_cust_part_no.</FPCLINE><FPCLINE>    gs_labels-lb_bnk_out_tax = |{ gs_labels-lb_bnk_out_tax }{ gs_header-output_tax_rate }|.</FPCLINE><FPCLINE>    gs_labels-lb_e_o_e = |{ gs_labels-lb_e_o_e } { gs_header-e_o_e }|..</FPCLINE><FPCLINE>  ENDIF.</FPCLINE><FPCLINE>ENDIF.</FPCLINE><FPCLINE/><FPCLINE>"Authorized Signatory Logo</FPCLINE><FPCLINE>CALL METHOD cl_ssf_xsf_utilities=&gt;get_bds_graphic_as_bmp</FPCLINE><FPCLINE>  EXPORTING</FPCLINE><FPCLINE>    p_object  = 'GRAPHICS'</FPCLINE><FPCLINE>    p_name    = gs_header-auth_logo</FPCLINE><FPCLINE>    p_id      = 'BMAP'</FPCLINE><FPCLINE>    p_btype   = 'BCOL' "BCOL for color, BMON for black/white</FPCLINE><FPCLINE>  RECEIVING</FPCLINE><FPCLINE>    p_bmp     = g_auth_sign</FPCLINE><FPCLINE>  EXCEPTIONS</FPCLINE><FPCLINE>    not_found = 1</FPCLINE><FPCLINE>    OTHERS    = 2.</FPCLINE><FPCLINE>"Header Logo</FPCLINE><FPCLINE>CALL METHOD cl_ssf_xsf_utilities=&gt;get_bds_graphic_as_bmp</FPCLINE><FPCLINE>  EXPORTING</FPCLINE><FPCLINE>    p_object  = 'GRAPHICS'</FPCLINE><FPCLINE>    p_name    = gs_header-logo</FPCLINE><FPCLINE>    p_id      = 'BMAP'</FPCLINE><FPCLINE>    p_btype   = 'BCOL' "BCOL for color, BMON for black/white</FPCLINE><FPCLINE>  RECEIVING</FPCLINE><FPCLINE>    p_bmp     = g_logo</FPCLINE><FPCLINE>  EXCEPTIONS</FPCLINE><FPCLINE>    not_found = 1</FPCLINE><FPCLINE>    OTHERS    = 2.</FPCLINE></INITIALIZATION><FORMS/></CL_FP_CODING></cls:CL_FP_CODING></asx:heap></asx:abap>